  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "- \u0421\u043B\u044B\u0445\u0430\u043B \u043E \u0441\u044D\u043D\u0434\u0432\u0438\u0447\u0435
    \u0441\u043E \u0441\u043F\u0443\u0449\u0435\u043D\u043A\u043E\u0439?\n- \u0410
    \u0447\u0442\u043E \u0442\u0430\u043A\u043E\u0435  \"\u0441\u043F\u0443\u0449\u0435\u043D\u043A\u0430\"?\n-
    \u0421\u0435\u0439\u0447\u0430\u0441 \u0443\u0437\u043D\u0430\u0435\u0442\u0435.
    \u041F\u0440\u044F\u043C\u043E \u0441\u0435\u0439\u0447\u0430\u0441! \u0421\u043E\u0441\u0443\u043D\u043A\u0438.\n-
    \u041D\u0443 \u0447\u0442\u043E, \u0432\u0440\u0435\u043C\u044F \u0436\u0440\u0430\u0442\u044C
    \u0441\u043F\u0443\u0449\u0435\u043D\u043A\u0443.\n- \u0410 \u044D\u0442\u0438
    \u0434\u0432\u043E\u0435, \u041E\u043D\u0438 \u0436\u0435 \u043D\u043E\u0432\u0435\u043D\u044C\u043A\u0438\u0435?\n-
    \u0418\u043C\u0438 \u0437\u0430\u0439\u043C\u0451\u0442\u0441\u044F \u0431\u043E\u043B\u044C\u0448\u043E\u0439
    \u0411\u043E\u0431.\n- \u0411\u043E\u043B\u044C\u0448\u043E\u0439 \u0431\u043E\u0431?
    \u0417\u0430 \u0440\u0430\u0431\u043E\u0442\u0443. \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E
    \u0430\u043F\u043F\u0435\u0442\u0438\u0442\u0430 \u0440\u0435\u0431\u044F\u0442\u0430."
