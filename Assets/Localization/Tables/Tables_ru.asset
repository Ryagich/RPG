  - m_Id: 80000000000000048
    m_Localized: "\u0421\u0432\u0435\u0442\u043B\u0430\u044F \u043F\u043E\u044F\u0441\u043D\u0430\u044F \u044E\u0431\u043A\u0430 \u0441\u043E\u0431\u0440\u0430\u043D\u0430 \u0438\u0437 \u0448\u0438\u0440\u043E\u043A\u0438\u0445 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0445 \u043F\u043E\u043B\u043E\u0442\u043D\u0438\u0449 \u0438 \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0447\u0435\u043D\u0430 \u0434\u0432\u0443\u043C\u044F \u0442\u0451\u043C\u043D\u044B\u043C\u0438 \u0440\u0435\u043C\u043D\u044F\u043C\u0438. \u0420\u043E\u0432\u043D\u044B\u0435 \u043F\u043E\u043B\u043E\u0441\u044B \u0442\u043A\u0430\u043D\u0438 \u0434\u0435\u0440\u0436\u0430\u0442 \u0444\u043E\u0440\u043C\u0443, \u0430 \u0440\u0435\u043C\u043D\u0438 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442 \u043F\u043E\u0434\u043E\u0433\u043D\u0430\u0442\u044C \u0432\u0435\u0449\u044C \u0431\u0435\u0437 \u0441\u043B\u043E\u0436\u043D\u043E\u0439 \u0448\u043D\u0443\u0440\u043E\u0432\u043A\u0438."
