  - m_Id: 80000000000000050
    m_Localized: "\u041A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u0430\u044F \u043D\u0430\u043A\u0438\u0434\u043A\u0430 \u0440\u0430\u0441\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043F\u043E \u0431\u043E\u043A\u0430\u043C \u043E\u0442 \u0441\u0432\u0435\u0442\u043B\u043E\u0439 \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u0439 \u0432\u0441\u0442\u0430\u0432\u043A\u0438 \u0441 \u0442\u0451\u043C\u043D\u043E\u0439 \u043E\u043A\u0430\u043D\u0442\u043E\u0432\u043A\u043E\u0439. \u041A\u043E\u0440\u043E\u0442\u043A\u0438\u0435 \u0440\u0430\u0437\u0440\u0435\u0437\u044B \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442 \u043A\u043E\u043B\u0435\u043D\u0438 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u043C\u0438, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0432\u0435\u0449\u044C \u0433\u043E\u0434\u0438\u0442\u0441\u044F \u0434\u043B\u044F \u0445\u043E\u0434\u044C\u0431\u044B, \u0430 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u044F \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0433\u043E \u0441\u0442\u043E\u044F\u043D\u0438\u044F."
