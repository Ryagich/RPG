    m_Metadata: {m_Items: []}
  - m_Id: 83000000000000010
    m_Localized: "\u0421\u043F\u0435\u043B\u044B\u0439 \u0442\u043E\u043C\u0430\u0442, \u0442\u044F\u0436\u0451\u043B\u044B\u0439 \u043E\u0442 \u0441\u043E\u043A\u0430 \u0438 \u0435\u0449\u0451 \u0434\u0435\u0440\u0436\u0430\u0449\u0438\u0439\u0441\u044F \u0437\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u0443\u044E \u0437\u0435\u043B\u0451\u043D\u0443\u044E \u043F\u043B\u043E\u0434\u043E\u043D\u043E\u0436\u043A\u0443. \u041E\u043D \u0431\u044B\u0441\u0442\u0440\u043E \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0432\u043B\u0430\u0433\u0443 \u0443\u0441\u0442\u0430\u0432\u0448\u0435\u043C\u0443 \u043F\u0443\u0442\u043D\u0438\u043A\u0443, \u043D\u043E \u043F\u043B\u043E\u0445\u043E \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442 \u0433\u0440\u0443\u0431\u043E\u0435 \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u0435: \u043F\u043E\u043B\u043E\u0436\u0438\u0448\u044C \u0435\u0433\u043E \u043D\u0430 \u0434\u043D\u043E \u0441\u0443\u043C\u043A\u0438 \u2014 \u043F\u043E\u043B\u0443\u0447\u0438\u0448\u044C \u043A\u0440\u0430\u0441\u043D\u043E\u0435 \u043F\u044F\u0442\u043D\u043E \u0432\u043C\u0435\u0441\u0442\u043E \u043F\u0440\u0438\u043F\u0430\u0441\u0430. \u041D\u0430 \u0440\u044B\u043D\u043A\u0430\u0445 \u0438\u0445 \u043F\u0440\u043E\u0434\u0430\u044E\u0442 \u0440\u0430\u043D\u043D\u0438\u043C \u0443\u0442\u0440\u043E\u043C, \u043F\u043E\u043A\u0430 \u0441\u043E\u043B\u043D\u0446\u0435 \u043D\u0435 \u0443\u0441\u043F\u0435\u043B\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043A\u043E\u0436\u0438\u0446\u0443 \u0432\u044F\u043B\u043E\u0439."
    m_Metadata: {m_Items: []}
