  - m_Id: 80000000000000016
    m_Localized: "\u041E\u0434\u043D\u043E\u0442\u043E\u043D\u043D\u0430\u044F \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u0430\u044F \u043F\u043E\u044F\u0441\u043D\u0430\u044F \u044E\u0431\u043A\u0430 \u0431\u0435\u0437 \u0437\u0430\u0441\u0442\u0451\u0436\u0435\u043A \u0438 \u043E\u0442\u0434\u0435\u043B\u043A\u0438. \u0415\u0451 \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0434\u0435\u0442\u044C \u043F\u043E\u0432\u0435\u0440\u0445 \u043B\u044E\u0431\u043E\u0439 \u043F\u0430\u0440\u044B \u0448\u0442\u0430\u043D\u043E\u0432, \u0430 \u0440\u043E\u0432\u043D\u044B\u0439 \u043A\u0440\u043E\u0439 \u043F\u0440\u043E\u0449\u0435 \u043F\u043E\u0447\u0438\u043D\u0438\u0442\u044C, \u0447\u0435\u043C \u0441\u043B\u043E\u0436\u043D\u044B\u0435 \u0432\u0435\u0449\u0438 \u0441 \u0440\u0435\u043C\u043D\u044F\u043C\u0438 \u0438 \u043D\u0430\u043A\u043B\u0430\u0434\u043A\u0430\u043C\u0438."
