  - m_Id: 83000000000000014
    m_Localized: "\u0413\u0443\u0441\u0442\u044B\u0435 \u043A\u0440\u0430\u0441\u043D\u043E\u0432\u0430\u0442\u044B\u0435 \u0433\u043E\u043B\u043E\u0432\u043A\u0438 \u0445\u0440\u0438\u0437\u0430\u043D\u0442\u0435\u043C \u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044F \u043D\u0430 \u0441\u0442\u0435\u0431\u043B\u0435 \u0434\u043E\u043B\u044C\u0448\u0435 \u043C\u043D\u043E\u0433\u0438\u0445 \u043F\u043E\u043B\u0435\u0432\u044B\u0445 \u0446\u0432\u0435\u0442\u043E\u0432. \u0418\u0445 \u0440\u0435\u0437\u043A\u0438\u0439 \u0437\u0430\u043F\u0430\u0445 \u043E\u0442\u043F\u0443\u0433\u0438\u0432\u0430\u0435\u0442 \u0447\u0430\u0441\u0442\u044C \u043D\u0430\u0441\u0435\u043A\u043E\u043C\u044B\u0445, \u0430 \u0440\u0430\u0441\u0442\u0451\u0440\u0442\u044B\u0435 \u043B\u0435\u043F\u0435\u0441\u0442\u043A\u0438 \u0432\u0445\u043E\u0434\u044F\u0442 \u0432 \u043F\u043E\u0445\u043E\u0434\u043D\u044B\u0435 \u043F\u0440\u0438\u043F\u0430\u0440\u043A\u0438 \u0434\u043B\u044F \u0443\u0441\u0442\u0430\u043B\u043E\u0439 \u043A\u043E\u0436\u0438 \u0438 \u043D\u0435\u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0445 \u0441\u0441\u0430\u0434\u0438\u043D; \u044D\u0442\u0438\u043C \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u044E\u0442 \u0437\u0430\u043C\u0435\u0442\u043D\u044B\u0439 \u043B\u0435\u0447\u0435\u0431\u043D\u044B\u0439 \u044D\u0444\u0444\u0435\u043A\u0442 \u0446\u0432\u0435\u0442\u043A\u0430. \u0421\u0432\u0435\u0436\u0443\u044E \u0432\u0435\u0442\u043A\u0443 \u043D\u0435 \u0441\u0443\u044E\u0442 \u0432 \u043A\u043E\u0442\u0435\u043B\u043E\u043A \u0431\u0435\u0437 \u0440\u0430\u0437\u0431\u043E\u0440\u0430: \u0443 \u0442\u0440\u0430\u0432\u043D\u0438\u043A\u043E\u0432 \u043E\u043D\u0430 \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435 \u0441\u044B\u0440\u044C\u0451, \u0430 \u043D\u0435 \u043E\u0431\u044B\u0447\u043D\u0430\u044F \u0437\u0435\u043B\u0435\u043D\u044C."
