    m_Localized: "\u0421\u0432\u0435\u0442\u043B\u0430\u044F \u043C\u043D\u043E\u0433\u043E\u0441\u043B\u043E\u0439\u043D\u0430\u044F \u043D\u0430\u043A\u0438\u0434\u043A\u0430 \u0441\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F \u043E\u0441\u0442\u0440\u044B\u043C \u043F\u043E\u043B\u043E\u0442\u043D\u0438\u0449\u0435\u043C \u043C\u0435\u0436\u0434\u0443 \u043D\u043E\u0433, \u0430 \u043D\u0430 \u0448\u0442\u0430\u043D\u0430\u0445 \u0437\u0430\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u044B \u0441\u0432\u0435\u0442\u043B\u044B\u0435 \u043F\u043E\u0434\u0432\u044F\u0437\u043A\u0438. \u0414\u0435\u0442\u0430\u043B\u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0442 \u0442\u043A\u0430\u043D\u044C \u0431\u043B\u0438\u0436\u0435 \u043A \u0442\u0435\u043B\u0443 \u0438 \u043D\u0435 \u0434\u0430\u044E\u0442 \u0435\u0439 \u0441\u0431\u0438\u0432\u0430\u0442\u044C\u0441\u044F \u0432 \u043A\u043E\u043C \u043F\u0440\u0438 \u0434\u043E\u043B\u0433\u043E\u0439 \u0445\u043E\u0434\u044C\u0431\u0435."
