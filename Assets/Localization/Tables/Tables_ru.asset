  - m_Id: 83000000000000006
    m_Localized: "\u041F\u043B\u043E\u0442\u043D\u0430\u044F \u0437\u0435\u043B\u0451\u043D\u0430\u044F \u0433\u043E\u043B\u043E\u0432\u043A\u0430 \u043D\u0430 \u0441\u0432\u0435\u0442\u043B\u043E\u043C \u0441\u0442\u0435\u0431\u043B\u0435, \u0441\u0440\u0435\u0437\u0430\u043D\u043D\u0430\u044F \u0434\u043E \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u0438\u044F \u043C\u0435\u043B\u043A\u0438\u0445 \u0431\u0443\u0442\u043E\u043D\u043E\u0432. \u0421\u0440\u0435\u0434\u0438 \u043F\u043E\u0445\u043E\u0434\u043D\u044B\u0445 \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432 \u043E\u043D\u0430 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043D\u0435\u043F\u0440\u0438\u0432\u044B\u0447\u043D\u043E, \u0437\u0430\u0442\u043E \u043D\u0435 \u0432\u044F\u043D\u0435\u0442 \u0432 \u043F\u0435\u0440\u0432\u044B\u0439 \u0436\u0435 \u0434\u0435\u043D\u044C \u0438 \u0434\u0430\u0451\u0442 \u0442\u0435\u043B\u0443 \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u043E\u0431\u0435\u0449\u0430\u0435\u0442 \u0435\u0451 \u0441\u043A\u0440\u043E\u043C\u043D\u044B\u0439 \u0432\u043A\u0443\u0441. \u0421\u0442\u0430\u0440\u044B\u0435 \u043E\u0433\u043E\u0440\u043E\u0434\u043D\u0438\u043A\u0438 \u0441\u0430\u0436\u0430\u044E\u0442 \u0435\u0451 \u0443 \u043A\u0440\u0430\u044F \u0433\u0440\u044F\u0434\u043A\u0438: \u0433\u043E\u0432\u043E\u0440\u044F\u0442, \u0447\u0435\u043C \u0445\u043E\u043B\u043E\u0434\u043D\u0435\u0435 \u043D\u043E\u0447\u044C, \u0442\u0435\u043C \u0447\u0435\u0441\u0442\u043D\u0435\u0435 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0435\u0451 \u0433\u043E\u0440\u0435\u0447\u044C."
    m_Metadata: {m_Items: []}
