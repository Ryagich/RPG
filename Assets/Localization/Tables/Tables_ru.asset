  - m_Id: 83000000000000008
    m_Localized: "\u0414\u043B\u0438\u043D\u043D\u044B\u0439 \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u044B\u0439 \u043A\u043E\u0440\u043D\u0435\u043F\u043B\u043E\u0434 \u0441 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0439 \u0437\u0435\u043B\u0451\u043D\u043E\u0439 \u0431\u043E\u0442\u0432\u043E\u0439 \u0438 \u0441\u043B\u0435\u0434\u043E\u043C \u0437\u0435\u043C\u043B\u0438 \u0443 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F. \u041C\u043E\u0440\u043A\u043E\u0432\u044C \u043D\u0435 \u0442\u0435\u0447\u0451\u0442 \u0432 \u0441\u0443\u043C\u043A\u0435, \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043E\u0433\u043D\u044F \u0438 \u0442\u0435\u0440\u043F\u0438\u0442 \u0434\u043E\u0440\u043E\u0433\u0443 \u043B\u0443\u0447\u0448\u0435 \u043D\u0435\u0436\u043D\u044B\u0445 \u043F\u043B\u043E\u0434\u043E\u0432; \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0435\u0451 \u0447\u0430\u0441\u0442\u043E \u0441\u0443\u044E\u0442 \u0432 \u043A\u0430\u0440\u043C\u0430\u043D \u043F\u0435\u0440\u0435\u0434 \u0432\u044B\u0445\u043E\u0434\u043E\u043C, \u043D\u0435 \u0440\u0430\u0437\u0434\u0443\u043C\u044B\u0432\u0430\u044F. \u0427\u0435\u043C \u0441\u043B\u0430\u0449\u0435 \u043A\u043E\u0440\u0435\u043D\u044C, \u0442\u0435\u043C \u0441\u0442\u0430\u0440\u0430\u0442\u0435\u043B\u044C\u043D\u0435\u0435 \u0435\u0433\u043E \u043F\u0440\u044F\u0447\u0443\u0442 \u043E\u0442 \u043B\u043E\u0448\u0430\u0434\u0435\u0439 \u0438 \u0434\u0435\u0442\u0435\u0439."
