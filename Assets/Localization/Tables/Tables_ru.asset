  - m_Id: 82000000000000006
    m_Localized: "\u041A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u044B\u0435 \u043A\u043E\u0436\u0430\u043D\u044B\u0435 \u0440\u0443\u043A\u0430\u0432\u0438\u0446\u044B \u0434\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u044B \u0441\u0432\u0435\u0442\u043B\u043E\u0439 \u043E\u0431\u043C\u043E\u0442\u043A\u043E\u0439 \u0443 \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u044F \u0438 \u0434\u0432\u0443\u043C\u044F \u0440\u043E\u043C\u0431\u043E\u0432\u0438\u0434\u043D\u044B\u043C\u0438 \u043D\u0430\u043A\u043B\u0430\u0434\u043A\u0430\u043C\u0438 \u043D\u0430 \u0442\u044B\u043B\u044C\u043D\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u0435. \u041E\u043D\u0438 \u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0442 \u043F\u0440\u043E\u0447\u043D\u0435\u0435 \u043E\u0431\u044B\u0447\u043D\u044B\u0445 \u043F\u0435\u0440\u0447\u0430\u0442\u043E\u043A \u0438 \u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044F \u043D\u0430 \u0440\u0443\u043A\u0435 \u0434\u0430\u0436\u0435 \u0442\u0430\u043C, \u0433\u0434\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0447\u0430\u0441\u0442\u043E \u0442\u044F\u043D\u0443\u0442\u044C \u0437\u0430 \u0440\u0435\u043C\u0435\u043D\u044C \u0438\u043B\u0438 \u0440\u0443\u043A\u043E\u044F\u0442\u044C."
