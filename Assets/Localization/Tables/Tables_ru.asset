  - m_Id: 80000000000000002
    m_Localized: "\u0422\u0440\u0438 \u043F\u043B\u043E\u0442\u043D\u044B\u0445 \u043F\u043E\u043B\u043E\u0442\u043D\u0438\u0449\u0430 \u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u0443 \u043F\u043E\u044F\u0441\u0430 \u0438 \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u0431\u0451\u0434\u0440\u0430 \u043F\u043E\u0432\u0435\u0440\u0445 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439 \u043E\u0434\u0435\u0436\u0434\u044B. \u0421\u0432\u0435\u0442\u043B\u044B\u0435 \u043D\u0430\u043A\u043B\u0430\u0434\u043A\u0438 \u043D\u0430 \u043A\u043E\u043D\u0446\u0430\u0445 \u0434\u0435\u043B\u0430\u044E\u0442 \u0432\u0435\u0449\u044C \u0437\u0430\u043C\u0435\u0442\u043D\u0435\u0435, \u043D\u043E \u0435\u0451 \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u0441\u043C\u044B\u0441\u043B \u043F\u0440\u043E\u0441\u0442: \u0442\u043A\u0430\u043D\u044C \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442 \u043D\u0430 \u0441\u0435\u0431\u044F \u0433\u0440\u044F\u0437\u044C \u0438 \u0442\u0440\u0435\u043D\u0438\u0435 \u043F\u0440\u0435\u0436\u0434\u0435, \u0447\u0435\u043C \u043E\u043D\u0438 \u0434\u043E\u0431\u0435\u0440\u0443\u0442\u0441\u044F \u0434\u043E \u0448\u0442\u0430\u043D\u043E\u0432."
