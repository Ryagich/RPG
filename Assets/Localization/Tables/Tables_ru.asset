    m_Localized: "\u0414\u043B\u0438\u043D\u043D\u044B\u0435 \u0431\u043E\u043A\u043E\u0432\u044B\u0435 \u043F\u043E\u043B\u043E\u0442\u043D\u0438\u0449\u0430 \u043E\u0431\u0440\u0430\u043C\u043B\u044F\u044E\u0442 \u0442\u0451\u043C\u043D\u0443\u044E \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u0443\u044E \u0442\u043A\u0430\u043D\u044C \u0438 \u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u0432 \u0437\u0430\u043E\u0441\u0442\u0440\u0451\u043D\u043D\u043E\u043C \u043F\u0435\u0440\u0435\u0434\u043D\u0438\u043A\u0435. \u0421\u0432\u0435\u0442\u043B\u0430\u044F \u043A\u0430\u0439\u043C\u0430 \u0438 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0439 \u0443\u0437\u043E\u0440 \u0434\u0435\u043B\u0430\u044E\u0442 \u0432\u0435\u0449\u044C \u0437\u0430\u043C\u0435\u0442\u043D\u043E\u0439, \u043D\u043E \u0432\u0441\u0451 \u0435\u0449\u0451 \u043F\u0440\u0438\u0433\u043E\u0434\u043D\u043E\u0439 \u0434\u043B\u044F \u043F\u043E\u0432\u0441\u0435\u0434\u043D\u0435\u0432\u043D\u043E\u0439 \u043D\u043E\u0441\u043A\u0438."
