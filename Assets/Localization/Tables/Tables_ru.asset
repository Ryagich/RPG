  - m_Id: 80000000000000014
    m_Localized: "\u0414\u0432\u0430 \u0442\u0451\u043C\u043D\u044B\u0445 \u043F\u043E\u043B\u043E\u0442\u043D\u0438\u0449\u0430 \u043F\u043E \u0431\u043E\u043A\u0430\u043C \u0448\u0442\u0430\u043D\u043E\u0432 \u043E\u043A\u0430\u043D\u0442\u043E\u0432\u0430\u043D\u044B \u0441\u0432\u0435\u0442\u043B\u043E\u0439 \u0442\u043A\u0430\u043D\u044C\u044E \u0438 \u0440\u0430\u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u043F\u0440\u0438 \u0448\u0430\u0433\u0435. \u041D\u0438\u0447\u0435\u0433\u043E \u043B\u0438\u0448\u043D\u0435\u0433\u043E: \u0442\u0430\u043A\u0430\u044F \u0432\u0435\u0449\u044C \u0441\u043B\u0435\u0433\u043A\u0430 \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043D\u043E\u0433\u0438 \u0438 \u043D\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442 \u043D\u0430 \u0441\u0435\u0431\u0435 \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0433\u0440\u044F\u0437\u0438, \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u0438\u043D\u043D\u0430\u044F \u043D\u0430\u043A\u0438\u0434\u043A\u0430."
