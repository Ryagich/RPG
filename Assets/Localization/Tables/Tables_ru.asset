  - m_Id: 79000000000000006
    m_Localized: "\u041A\u043E\u0436\u0430\u043D\u044B\u0439 \u0436\u0438\u043B\u0435\u0442 \u043F\u043E\u0432\u0435\u0440\u0445 \u0441\u0432\u0435\u0442\u043B\u043E\u0439 \u0440\u0443\u0431\u0430\u0445\u0438 \u0441\u0442\u044F\u043D\u0443\u0442 \u043D\u0430 \u0433\u0440\u0443\u0434\u0438 \u0448\u0438\u0440\u043E\u043A\u0438\u043C\u0438 \u043F\u0435\u0440\u0435\u043A\u0440\u0435\u0449\u0435\u043D\u043D\u044B\u043C\u0438 \u0440\u0435\u043C\u043D\u044F\u043C\u0438. \u041F\u043E\u0441\u0430\u0434\u043A\u0443 \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0434\u0442\u044F\u043D\u0443\u0442\u044C \u043F\u043E \u0444\u0438\u0433\u0443\u0440\u0435 \u0431\u0435\u0437 \u043F\u043E\u0440\u0442\u043D\u043E\u0433\u043E, \u0430 \u0440\u0435\u043C\u043D\u0438 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u044E\u0442 \u043D\u0430 \u0441\u0435\u0431\u044F \u0431\u043E\u043B\u044C\u0448\u0443\u044E \u0447\u0430\u0441\u0442\u044C \u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0439 \u043F\u044B\u043B\u0438 \u0438 \u0446\u0430\u0440\u0430\u043F\u0438\u043D."
