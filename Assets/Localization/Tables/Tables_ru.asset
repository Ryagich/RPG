      \u043F\u043E\u0447\u0435\u043C\u0443 \u0432\u043E\u0440\u043E\u0442\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381582688259
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u043F\u0443\u0442\u044C \u0432
      \u0433\u043E\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381582688260
    m_Localized: "\u0413\u043E\u0440\u043E\u0434 \u0437\u0430\u043A\u0440\u044B\u0442
      \u0438\u0437-\u0437\u0430 \u044D\u043F\u0438\u0434\u0435\u043C\u0438\u0438.
      \u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u0438\u043D\u043E\u0439 \u0441\u043F\u043E\u0441\u043E\u0431
      \u043F\u043E\u043F\u0430\u0441\u0442\u044C \u0432\u043D\u0443\u0442\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381582688261
    m_Localized: "\u0410\u043b\u044c\u0434\u0440\u0435\u043d \u0412\u0430\u044d\u043b\u044c"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381582688262
    m_Localized: "\u0422\u044B \u0443\u0436\u0435 \u0443\u0441\u043F\u0435\u043B
      \u043F\u043E\u0441\u0447\u0438\u0442\u0430\u0442\u044C, \u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0442\u0430\u043C \u043A\u043E\u043F\u0438\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381582688263
    m_Localized: "\u041D\u0435\u0442. \u0410 \u043D\u0430\u0434\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381582688264
    m_Localized: "\u041D\u0435 \u043D\u0430\u0434\u043E. \u0418\u0445 \u0438 \u0431\u0435\u0437
      \u0441\u0447\u0451\u0442\u0430 \u0445\u0432\u0430\u0442\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381582688265
    m_Localized: "Так. Нас не пускают. И, судя по лицам у ворот, это не потому, что им скучно."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381582688266
    m_Localized: "Освин Марлоу хочет обсудить закрытые ворота."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882560
    m_Localized: "Похоже, у них приказ."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882561
    m_Localized: "Похоже. Ворота закрыли наглухо, а стража держится так, будто за стеной не город, а осаждённая крепость."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882562
    m_Localized: "\u041C\u043E\u0436\u0435\u0442, \u0434\u043E \u0443\u0442\u0440\u0430
      \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882563
    m_Localized: "\u041E\u0431\u043E\u0439\u0434\u0451\u043C \u0433\u043E\u0440\u043E\u0434?"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882564
    m_Localized: "\u0422\u044B \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
      \u0441\u043B\u044B\u0448\u0430\u043B \u043F\u043E \u0434\u043E\u0440\u043E\u0433\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882565
    m_Localized: "\u041C\u043E\u0436\u0435\u043C. \u0422\u043E\u043B\u044C\u043A\u043E
      \u0443\u0442\u0440\u043E\u043C \u043E\u043D\u0438 \u0431\u0443\u0434\u0443\u0442
      \u0442\u0435\u043C\u0438 \u0436\u0435 \u043B\u044E\u0434\u044C\u043C\u0438,
      \u0441 \u0442\u0435\u043C \u0436\u0435 \u043F\u0440\u0438\u043A\u0430\u0437\u043E\u043C.
      \u042F \u0431\u044B \u043D\u0430 \u0447\u0443\u0434\u043E \u043D\u0435 \u0441\u0442\u0430\u0432\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882566
    m_Localized: "\u0427\u0435\u0440\u0435\u0437 \u043B\u0435\u0441? \u041F\u043E\u0442\u043E\u043C
      \u0443\u043F\u0440\u0451\u043C\u0441\u044F \u0432 \u0434\u0440\u0443\u0433\u043E\u0439
      \u043F\u043E\u0441\u0442 \u0438 \u0432\u0441\u0451 \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0435\u043C
      \u0437\u0430\u043D\u043E\u0432\u043E. \u041E\u0447\u0435\u043D\u044C \u0445\u043E\u0447\u0435\u0442\u0441\u044F,
      \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u043F\u043E\u0441\u043B\u0435
      \u0442\u0430\u043A\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882567
    m_Localized: "\u0423 \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438
      \u043F\u0440\u043E \u0431\u043E\u043B\u044C\u043D\u044B\u0445. \u041E\u0434\u0438\u043D
      \u0432\u043E\u0437\u0447\u0438\u043A \u043A\u043B\u044F\u043B\u0441\u044F,
      \u0447\u0442\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0443 \u043D\u0435\u0433\u043E
      \u0432 \u0442\u0435\u043B\u0435\u0433\u0435 \u0443\u043C\u0435\u0440 \u0435\u0449\u0451
      \u0434\u043E \u043F\u043E\u043B\u0443\u0434\u043D\u044F. \u0414\u0440\u0443\u0433\u043E\u0439
      \u0441\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u044D\u0442\u043E
      \u0432\u0441\u0451 \u0432\u044B\u0434\u0443\u043C\u043A\u0438 \u0441\u043E\u0432\u0435\u0442\u0430.
      \u0412 \u043E\u0431\u0449\u0435\u043C, \u043A\u0430\u0436\u0434\u044B\u0439
      \u0437\u043D\u0430\u0435\u0442 \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430
      \u2014 \u0438 \u043D\u0438\u043A\u0442\u043E \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u0437\u043D\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882568
    m_Localized: "\u0418 \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882569
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438 \u0441 \u0433\u043B\u0430\u0432\u043E\u0439
      \u0441\u0442\u0440\u0430\u0436\u0438. \u041D\u0435 \u043A\u0430\u043A \u0441
      \u0432\u043E\u0440\u043E\u0442\u0430\u043C\u0438 \u2014 \u043A\u0430\u043A
      \u0441 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C. \u0421\u043F\u0440\u043E\u0441\u0438,
      \u0447\u0442\u043E \u0443 \u043D\u0438\u0445 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442,
      \u043A\u043E\u0433\u043E \u043F\u0443\u0441\u043A\u0430\u044E\u0442, \u043A\u043E\u0433\u043E
      \u043D\u0435\u0442. \u0415\u0441\u043B\u0438 \u0432 \u043F\u0440\u0438\u043A\u0430\u0437\u0435
      \u0435\u0441\u0442\u044C \u0445\u043E\u0442\u044C \u043A\u0430\u043A\u0430\u044F-\u0442\u043E
      \u043B\u0430\u0437\u0435\u0439\u043A\u0430, \u043E\u043D \u043E \u043D\u0435\u0439
      \u0437\u043D\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882570
    m_Localized: "\u041B\u0430\u0434\u043D\u043E. \u041F\u043E\u0433\u043E\u0432\u043E\u0440\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882571
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438. \u0410 \u044F
      \u043F\u043E\u043A\u0430 \u043F\u043E\u0441\u0442\u043E\u044E \u0437\u0434\u0435\u0441\u044C
      \u0438 \u0441\u0434\u0435\u043B\u0430\u044E \u0432\u0438\u0434, \u0447\u0442\u043E
      \u043D\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u044E \u043A\u043E\u043F\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882572
    m_Localized: "\u042D\u0439. \u041E\u0442 \u0440\u0435\u0448\u0451\u0442\u043A\u0438
      \u043E\u0442\u043E\u0439\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882573
    m_Localized: "\u042F \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043C\u043E\u0442\u0440\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882574
    m_Localized: "\u0421\u043C\u043E\u0442\u0440\u0438 \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430.
      \u041C\u043D\u0435 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882575
    m_Localized: "\u0412 \u0433\u043E\u0440\u043E\u0434? \u0412\u0438\u0436\u0443.
      \u0417\u0430\u0447\u0435\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882576
    m_Localized: "\u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0432 \u0433\u043E\u0440\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882577
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0432\u043E\u0440\u043E\u0442\u0430
      \u0437\u0430\u043A\u0440\u044B\u043B\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882578
    m_Localized: "\u041A\u0442\u043E \u043E\u0442\u0434\u0430\u043B \u043F\u0440\u0438\u043A\u0430\u0437?"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882579
    m_Localized: "\u041C\u043E\u0436\u0435\u0442, \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C
      \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882580
    m_Localized: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0432
      \u0433\u043E\u0440\u043E\u0434\u0435 \u043B\u044E\u0434\u0438 \u0432\u0430\u043B\u044F\u0442\u0441\u044F
      \u0441 \u043D\u043E\u0433. \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0432
      \u043D\u0438\u0436\u043D\u0435\u043C \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u0435,
      \u043F\u043E\u0442\u043E\u043C \u0432 \u043F\u043E\u0440\u0442\u0443. \u041B\u0435\u043A\u0430\u0440\u0438
      \u0433\u043E\u0432\u043E\u0440\u044F\u0442 \u2014 \u0437\u0430\u0440\u0430\u0437\u0430.
      \u0421\u043E\u0432\u0435\u0442 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u2014
      \u043A\u0430\u0440\u0430\u043D\u0442\u0438\u043D. \u0410 \u044F \u0433\u043E\u0432\u043E\u0440\u044E:
      \u0441\u0442\u043E\u0439 \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882581
    m_Localized: "\u0421\u043E\u0432\u0435\u0442. \u041E\u043D\u0438 \u0441\u0438\u0434\u044F\u0442
      \u0437\u0430 \u0441\u0442\u0435\u043D\u043E\u0439, \u043C\u044B \u2014 \u0441
      \u044D\u0442\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B. \u041E\u0447\u0435\u043D\u044C
      \u0443\u0434\u043E\u0431\u043D\u043E \u0443\u0441\u0442\u0440\u043E\u0438\u043B\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882582
    m_Localized: "\u0421 \u043A\u0435\u043C? \u0421\u043E \u043C\u043D\u043E\u0439?
      \u041D\u0435 \u0441\u043C\u0435\u0448\u0438. \u041C\u043D\u0435 \u0437\u0430
      \u0442\u0435\u0431\u044F \u043F\u043E\u0442\u043E\u043C \u043E\u0442\u0432\u0435\u0447\u0430\u0442\u044C.
      \u0418 \u0434\u0435\u043D\u0435\u0433 \u0441\u0435\u0439\u0447\u0430\u0441
      \u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0442\u0440\u043E\u0433\u0430\u0442\u044C,
      \u0435\u0441\u043B\u0438 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882583
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u043D\u0435 \u0432\u043F\u0443\u0441\u0442\u0438\u0442\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882584
    m_Localized: "\u041D\u0435 \u0447\u0435\u0440\u0435\u0437 \u0432\u043E\u0440\u043E\u0442\u0430.
      \u041D\u0438\u043A\u043E\u0433\u043E \u043D\u0435 \u0432\u043F\u0443\u0441\u043A\u0430\u0435\u043C
      \u0438 \u043D\u0435 \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u043C,
      \u043F\u043E\u043A\u0430 \u043B\u0435\u043A\u0430\u0440\u0438 \u043D\u0435
      \u0440\u0430\u0437\u0431\u0435\u0440\u0443\u0442\u0441\u044F. \u042F \u043D\u0435
      \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0437\u0430 \u0431\u043E\u043B\u0435\u0437\u043D\u044C.
      \u0418, \u0447\u0435\u0441\u0442\u043D\u043E, \u0437\u043D\u0430\u0442\u044C
      \u043D\u0435 \u0445\u043E\u0447\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882585
    m_Localized: "\u041F\u043E\u043D\u044F\u0442\u043D\u043E. \u0411\u0443\u0434\u0443
      \u0438\u0441\u043A\u0430\u0442\u044C \u0434\u0440\u0443\u0433\u043E\u0439 \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882586
    m_Localized: "\u0418\u0449\u0438. \u0422\u043E\u043B\u044C\u043A\u043E \u0447\u0435\u0440\u0435\u0437
      \u0441\u0442\u0435\u043D\u0443 \u0443 \u043C\u043E\u0435\u0433\u043E \u043F\u043E\u0441\u0442\u0430
      \u043D\u0435 \u043B\u0435\u0437\u044C. \u0422\u043E\u0433\u0434\u0430 \u043C\u043D\u0435
      \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0441\u0442\u0440\u0435\u043B\u044F\u0442\u044C,
      \u0430 \u043C\u043D\u0435 \u0438 \u0431\u0435\u0437 \u0442\u043E\u0433\u043E
      \u0440\u0430\u0431\u043E\u0442\u044B \u0445\u0432\u0430\u0442\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882587
    m_Localized: "Вот и город. Добрались всё-таки. Я уже начал думать, что эта дорога нас переживёт."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882588
    m_Localized: "Освин Марлоу хочет поговорить после долгой дороги."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882589
    m_Localized: "Нет (Отказаться от обучения)"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882590
    m_Localized: "Да (Пройти обучение бою — рекомендуется)"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882591
    m_Localized: "Вот это разговор. Ринг у ворот, справа от частокола. Подходи, когда будешь готов — поглядим, что дорога успела выбить из твоей стойки."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882592
    m_Localized: "Добрались. Ещё день в седле — и я бы начал спорить с лошадью."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882593
    m_Localized: "Город-то есть. Только у ворот нас явно не ждали."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882594
    m_Localized: "Не спорь с лошадью — у неё характер тяжелее твоего. А город... видишь сам: стены, дым из труб, люди. После такой дороги даже это радует."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882595
    m_Localized: "Не ждали. Копья выставили, ворота закрыли. Но я всё равно рад стенам, крыше и тому, что сегодня нам, может, не придётся ночевать в грязи."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882596
    m_Localized: "Радует. Особенно если за этими стенами найдётся горячая еда."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882597
    m_Localized: "Ты удивительно легко миришься с плохим приёмом."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882598
    m_Localized: "А чего суетиться? Мы уже здесь. Видишь ринг у стражи — огороженную площадку у ворот? Пока они решают, кого пускать, можно размяться. Мы с тобой давно не дрались не ради спасения шкуры. Давай выйдем на ринг, проверим руки и голову."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000001
    m_Localized: "Пробел — скрыть"
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000010
    m_Localized: "Бой требует оценки риска. Перед столкновением учитывайте число противников, их вооружение и запас выносливости. Если исход неочевиден, обойдите противника: сражение не всегда является оптимальным решением."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000011
    m_Localized: "Оказавшись в поле зрения противника, будьте готовы к нападению. Одни враги держат дистанцию, другие идут в лоб — их поведение зависит от фракции и вооружения."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000012
    m_Localized: "Уклонение: нажмите [{Dodge}]. Направление уклонения соответствует текущему направлению движения. Выполните уклонение после начала атаки Освина."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000013
    m_Localized: "Холодное оружие поддерживает обычную и тяжёлую атаку: [{LightAttack}] — обычная, [{HeavyAttack}] — тяжёлая. Атаки расходуют выносливость и имеют разный темп."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000014
    m_Localized: "После успешной атаки разрывайте дистанцию, чтобы восстановить контроль над боем. Нажмите [{Roll}] для кувырка в направлении движения."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000015
    m_Localized: "Выносливость расходуется на передвижение, атаки, уклонения и кувырки. В бою пустая шкала выносливости опаснее потери здоровья: без ресурса нельзя выполнять манёвры и атакующие действия."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000016
    m_Localized: "Предметы могут восстанавливать выносливость. Масса снаряжения влияет на скорость передвижения и темп расхода выносливости: перегруженный персонаж медленнее и быстрее устаёт."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000017
    m_Localized: "Контроль завершён. Примените освоенные действия в бою и победите Освина."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000020
    m_Localized: "Оцените условия боя и закройте подсказку."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000021
    m_Localized: "Войдите в поле зрения Освина."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000022
    m_Localized: "Уклонитесь от атаки Освина: [{Dodge}]."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000023
    m_Localized: "Атакуйте Освина: [{LightAttack}] — обычная, [{HeavyAttack}] — тяжёлая атака."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000024
    m_Localized: "Завершите кувырок: [{Roll}]."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000025
    m_Localized: "Изучите расход выносливости."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000026
    m_Localized: "Учтите влияние веса снаряжения на выносливость."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000027
    m_Localized: "Победите Освина в учебном бою."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000002
    m_Localized: "Пока"
    m_Metadata:
      m_Items: []
  - m_Id: 72000000000000001
    m_Localized: "Неплохо. Пять минут без лишней спешки — уже работа, а не махание железом."
    m_Metadata:
      m_Items: []
  - m_Id: 72000000000000002
    m_Localized: "Ничья. Ты держался, я не давил. Значит, тренировку провели с толком."
    m_Metadata:
      m_Items: []
  - m_Id: 72000000000000003
    m_Localized: "Время вышло. Руки помнят, голова тоже — этого на сегодня достаточно."
    m_Metadata:
      m_Items: []
  - m_Id: 72000000000000004
    m_Localized: "Чисто сработано. Не расслабляйся: настоящий противник не станет ждать удобного момента."
    m_Metadata:
      m_Items: []
  - m_Id: 72000000000000005
    m_Localized: "Хороший темп. Победа в тренировке ничего не гарантирует, но привычка думать уже есть."
    m_Metadata:
      m_Items: []
  - m_Id: 72000000000000006
    m_Localized: "Ладно, признаю: сегодня ты был быстрее. Запомни, за счёт чего взял бой."
    m_Metadata:
      m_Items: []
  - m_Id: 72000000000000007
    m_Localized: "Поторопился — и открылся. Ошибку увидел, теперь исправляй."
    m_Metadata:
      m_Items: []
  - m_Id: 72000000000000008
    m_Localized: "В бою не хватает одного удара, если после него нечем дышать. Следи за выносливостью."
    m_Metadata:
      m_Items: []
  - m_Id: 72000000000000009
    m_Localized: "Ничего страшного. Поражение на тренировке дешевле ошибки за городскими стенами."
    m_Metadata:
      m_Items: []
  - m_Id: 72000000000000010
    m_Localized: "Понял."
    m_Metadata:
      m_Items: []
  - m_Id: 73000000000000001
    m_Localized: "Размять кости."
    m_Metadata:
      m_Items: []
  - m_Id: 73000000000000002
    m_Localized: "Как хочешь размяться?"
    m_Metadata:
      m_Items: []
  - m_Id: 73000000000000003
    m_Localized: "Спарринг."
    m_Metadata:
      m_Items: []
  - m_Id: 73000000000000004
    m_Localized: "Пройти обучение ещё раз."
    m_Metadata:
      m_Items: []
  - m_Id: 73000000000000005
    m_Localized: "Потренировать уклонения и кувырки."
    m_Metadata:
      m_Items: []
  - m_Id: 73000000000000006
    m_Localized: "Я передумал."
    m_Metadata:
      m_Items: []
  - m_Id: 74000000000000001
    m_Localized: "Успешно уклонитесь от атак Освина: {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 74000000000000002
    m_Localized: "Тренировка уклонения"
    m_Metadata:
      m_Items: []
  - m_Id: 74000000000000003
    m_Localized: "Уклоняйтесь от атак Освина, используя увороты и кувырки."
    m_Metadata:
      m_Items: []
  - m_Id: 74000000000000004
    m_Localized: "Пройти тренировку"
    m_Metadata:
      m_Items: []
  - m_Id: 74000000000000005
    m_Localized: "Освин проводит учебный бой. Освойте основные приёмы, чтобы уверенно действовать в настоящей схватке."
    m_Metadata:
      m_Items: []
  - m_Id: 74000000000000006
    m_Localized: "Научиться всем действиям"
    m_Metadata:
      m_Items: []
  - m_Id: 74000000000000007
    m_Localized: "Освойте базовые действия бойца: оценку обстановки, уклонение, атаки, кувырок и управление выносливостью."
    m_Metadata:
      m_Items: []
  - m_Id: 74000000000000008
    m_Localized: "Победить Освина"
    m_Metadata:
      m_Items: []
  - m_Id: 74000000000000009
    m_Localized: "Примените изученные приёмы в учебном бою и одолейте Освина."
    m_Metadata:
      m_Items: []
  - m_Id: 30000000000000003
    m_Localized: Пропустить
    m_Metadata:
      m_Items: []
  - m_Id: 30000000000000004
    m_Localized: "Журнал"
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000001
    m_Localized: "Я хотел бы у тебя кое-что узнать."
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000002
    m_Localized: "Что именно хотел узнать?"
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000003
    m_Localized: "Говори. Я слушаю."
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000004
    m_Localized: "Ну? Что у тебя на уме?"
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000005
    m_Localized: "Спрашивай, пока у меня терпение не кончилось."
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000006
    m_Localized: "Да-да. Выкладывай."
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000007
    m_Localized: "Что скажешь о лесе?"
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000008
    m_Localized: "Сам лес никуда не делся. Деревья стоят, птицы поют — когда им вздумается. А вот тракт под ними словно вымер. Прежде к закату там телеги обгоняли друг друга, путники ругались из-за места у огня. Теперь пройдёшь полдня и встретишь разве что следы в грязи. И не всякий след хочется разглядывать."
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000009
    m_Localized: "Разбойники распугали людей?"
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000010
    m_Localized: "Отчасти. Разбойник — беда простая: жадный, голодный, с ножом. Его можно обойти, подкупить или встретить с оружием в руке. Только и они в лесу теперь долго не сидят. Я видел их стоянку: костёр затушен, котелок брошен, а дозорный следит не за дорогой — за чащей. Значит, боятся там не одни путники."
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000011
    m_Localized: "А что за чувство, будто следят?"
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000012
    m_Localized: "Не знаю. И оттого оно хуже. Ни шороха, ни следа, ни дыма между стволами. Просто идёшь — и вдруг уверен, что за спиной кто-то остановился вместе с тобой. Обернёшься: мох, корни, ветки. Волк честнее: увидишь зубы — поймёшь, что делать. А тут лес молчит, будто слушает. После заката я туда не хожу."
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000013
    m_Localized: "Как тебе здешняя таверна?"
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000014
    m_Localized: "Добрая была таверна. Когда тракт жил, в ней с утра спорили о ценах, к ночи — о богах, а к рассвету кто-нибудь обязательно спал лицом в столе. Теперь в зале просторно. Слышно, как ложка о миску стукает. Но хозяйка не скисла: огонь в очаге держит, столы моет, будто обозы вот-вот снова потянутся. Упрямая женщина. Такие места на упрямстве и стоят."
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000015
    m_Localized: "А кормят там и правда хорошо?"
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000016
    m_Localized: "Если не станешь допытываться, откуда в похлёбке мясо, — очень даже. Хлеб у неё горячий, лук не жалеет, а от одной миски у человека снова появляются мысли о завтрашнем дне. В наши дни за такое и монету отдать не жалко. Только не хвали слишком громко: хозяйка сделает вид, что не слышит, а потом положит тебе добавку."
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000017
    m_Localized: "Почему в ней теперь пусто?"
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000018
    m_Localized: "Потому что дорога перестала кормить. Путник едет, когда знает: впереди ночлег, работа или хотя бы рынок. А когда впереди слухи, закрытые ворота и люди с ножами, он остаётся дома. Таверна тут ни при чём. Просто миру нынче не до кружек и песен."
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000019
    m_Localized: "Что там с рекой?"
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000020
    m_Localized: "Днём — река как река: мелководье, камыш, стрекозы над водой. А в сумерках она меняется. Камыш шевелится против ветра, по воде круги идут там, где рыбе делать нечего. Говорят, завелось что-то водяное. Днём к берегу не лезет — может, света не любит. Ночью я бы там даже флягу не полоскал."
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000021
    m_Localized: "И всё-таки к реке стоит ходить?"
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000022
    m_Localized: "Если дело есть — стоит. У отмелей растёт кровоцвет: невзрачный с виду, зато рану стянет лучше иной дорогой мази. Собирай утром, пока видно дно. И не тянись за каждым цветком: один глаз на траве, второй держи на воде. Река терпит осторожных. Остальных потом долго ищут ниже по течению."
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000023
    m_Localized: "А кто живёт в деревне ниже по течению?"
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000024
    m_Localized: "Люди говорят: нелюди. А люди много чего говорят, особенно если видели дым над чужими крышами и лодку без фонаря. Я там не был, так что врать не стану. Рыбаки спускаются ниже редко и возвращаются без улова, но целые. Если соберёшься туда, не лезь с расспросами, кто они да чем хуже нас. Сначала поздоровайся. Иногда этого достаточно, чтобы вернуться обратно."
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000025
    m_Localized: "Расскажи о деревне у тракта."
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000026
    m_Localized: "Ничем с виду не приметная: кривые заборы, огороды, дети босиком до первых холодов. Но место стояло на тракте, а значит — жило. Кому овса продать, кому колесо подправить, кому постель в таверне застелить. Проезжий оставлял монету, а деревня крутилась дальше. Пока дорога была полна людей, и в деревне было кому ругаться, торговаться и строить планы."
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000027
    m_Localized: "Выходит, всё там держится на таверне?"
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000028
    m_Localized: "Не на одной таверне — на всём, что вокруг неё крутилось. Кузнец подковы ковал, мельник муку молол, вдовы стирали чужое бельё, мальчишки бегали за возами. Один путник купит кружку, другой заплатит за починку — и у десятка людей на ужин что-то найдётся. Без дороги это не деревня у тракта, а просто несколько дворов, которым стало тесно со своей бедой."
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000029
    m_Localized: "А что с ней теперь?"
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000030
    m_Localized: "Не скажу. Раньше оттуда каждый день кто-нибудь ехал: с зерном, за солью, да хоть просто языком почесать. Теперь никого. Может, пережидают и дверей не открывают. А может, им уже некому ехать. Гадать не люблю. От гаданий дорога не становится безопаснее, а люди — живее."
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000031
    m_Localized: "Что думаешь о городе?"
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000032
    m_Localized: "Издали город всегда кажется спасением: стены, крыши, дым из труб. Думаешь, за воротами тебя ждут еда и порядок. Потом подходишь ближе — видишь очередь, копья и лица стражи. За стенами есть работа, рынок, лекарь. Там же есть чужие законы и люди, которым выгодно, чтобы ты их боялся. Но всё равно: я выберу город, а не ночёвку в лесу. У стен хотя бы понятные зубы."
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000033
    m_Localized: "Почему ворота не открывают?"
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000034
    m_Localized: "Будь у меня ответ, я бы не мёрз под этими стенами вместе с остальными. Город закрывает ворота, когда боится того, что идёт к нему, или того, что уже успело войти. Стража молчит. А когда вооружённые люди молчат, смотри не на рот — на руки. Эти держат копья так, будто ждут беды с обеих сторон."
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000036
    m_Localized: "Спрошу о чём-нибудь ещё."
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000037
    m_Localized: "Спасибо. Мне пора."
    m_Metadata: {m_Items: []}
  - m_Id: 75000000000000038
    m_Localized: "Вернуться к разговору."
    m_Metadata: {m_Items: []}
  - m_Id: 76000000000000001
    m_Localized: "Есть ли ко мне дело?"
    m_Metadata: {m_Items: []}
  - m_Id: 76000000000000002
    m_Localized: "Дела всегда найдутся. Только сперва скажи, о чём речь."
    m_Metadata: {m_Items: []}
  - m_Id: 76000000000000003
    m_Localized: "Что за простая просьба?"
    m_Metadata: {m_Items: []}
  - m_Id: 76000000000000004
    m_Localized: "Яблок хочу. Не пирогов, не бочки сидра — просто яблок. Десяток. В дороге привык: от кислого яблока голова яснее, чем от половины советов."
    m_Metadata: {m_Items: []}
  - m_Id: 76000000000000005
    m_Localized: "Ладно. Принесу тебе десять яблок."
    m_Metadata: {m_Items: []}
  - m_Id: 76000000000000006
    m_Localized: "Вот и славно. Не торопись обдирать последнее дерево у чьего-нибудь дома — мне яблоки нужны, а не новая ссора."
    m_Metadata: {m_Items: []}
  - m_Id: 76000000000000007
    m_Localized: "А что за дело с человеком?"
    m_Metadata: {m_Items: []}
  - m_Id: 76000000000000008
    m_Localized: "В деревне жил кузнец, старый знакомый. Руки у него тяжёлые, язык ещё тяжелее, но человек надёжный. Давно от него ни весточки. Навести его, если дорога туда откроется."
    m_Metadata: {m_Items: []}
  - m_Id: 76000000000000009
    m_Localized: "Хорошо. Поищу кузнеца."
    m_Metadata: {m_Items: []}
  - m_Id: 76000000000000010
    m_Localized: "Скажи ему, Освин ещё помнит, кто однажды подковал ему коня в долг. Он поймёт. А если сделает вид, что не понял — значит, жив и по-прежнему упрям."
    m_Metadata: {m_Items: []}
  - m_Id: 76000000000000011
    m_Localized: "Я принёс яблоки. Ровно десять."
    m_Metadata: {m_Items: []}
  - m_Id: 76000000000000012
    m_Localized: "Дай взглянуть... Хорошие. Не царский стол, конечно, но в дороге и такое богатством кажется. Спасибо."
    m_Metadata: {m_Items: []}
  - m_Id: 76000000000000013
    m_Localized: "Яблоки для Освина"
    m_Metadata: {m_Items: []}
  - m_Id: 76000000000000014
    m_Localized: "Освин попросил раздобыть для него десять яблок."
    m_Metadata: {m_Items: []}
  - m_Id: 76000000000000015
    m_Localized: "Собрать десять яблок"
    m_Metadata: {m_Items: []}
  - m_Id: 76000000000000016
    m_Localized: "Соберите десять яблок для Освина."
    m_Metadata: {m_Items: []}
  - m_Id: 76000000000000017
    m_Localized: "Отнести яблоки Освину"
    m_Metadata: {m_Items: []}
  - m_Id: 76000000000000018
    m_Localized: "У вас есть десять яблок. Вернитесь к Освину."
    m_Metadata: {m_Items: []}
  - m_Id: 76000000000000019
    m_Localized: "Старый знакомый Освина"
    m_Metadata: {m_Items: []}
  - m_Id: 76000000000000020
    m_Localized: "Освин просит навестить своего знакомого-кузнеца в деревне."
    m_Metadata: {m_Items: []}
  - m_Id: 76000000000000021
    m_Localized: "Найти кузнеца"
    m_Metadata: {m_Items: []}
  - m_Id: 76000000000000022
    m_Localized: "Доберитесь до деревни и разыщите кузнеца, о котором говорил Освин."
    m_Metadata: {m_Items: []}
  - m_Id: 77000000000000001
    m_Localized: "Что тут вокруг творится?"
    m_Metadata: {m_Items: []}
  - m_Id: 77000000000000002
    m_Localized: "Вокруг — сырость, пустые дороги и те, кто решил, что закон ушёл вместе с путниками. Спрашивай, если не за пустым языком."
    m_Metadata: {m_Items: []}
  - m_Id: 77000000000000003
    m_Localized: "Что в лесу?"
    m_Metadata: {m_Items: []}
  - m_Id: 77000000000000004
    m_Localized: "Лес как лес. Только теперь тебя там раньше зверя услышит человек с луком. Двоих недавно выводили: с тракта сошли на пару шагов, потом — крик, беготня. Одного нашли. Второго лес себе оставил."
    m_Metadata: {m_Items: []}
  - m_Id: 77000000000000005
    m_Localized: "Значит, там разбойники?"
    m_Metadata: {m_Items: []}
  - m_Id: 77000000000000006
    m_Localized: "Есть. Сидят у старой лесной дороги, где телегу не развернуть. Выскочат, заорут, лошадь спугнут — и пока ты сообразишь, что к чему, уже без кошеля. Один ходи только по нужде. И то недалеко."
    m_Metadata: {m_Items: []}
  - m_Id: 77000000000000007
    m_Localized: "А река?"
    m_Metadata: {m_Items: []}
  - m_Id: 77000000000000008
    m_Localized: "Днём у брода тихо. Ночью — не знаю. Видел, как вода плеснула, будто кто-то в ней бревно перевернул. Потом лодочник с берега дал дёру, весло бросил. Здоровый мужик, между прочим."
    m_Metadata: {m_Items: []}
  - m_Id: 77000000000000009
    m_Localized: "Переправляться можно?"
    m_Metadata: {m_Items: []}
  - m_Id: 77000000000000010
    m_Localized: "Можно. Пока светло, по мелкому месту и без железа на себе. Полезешь в камыши за травой — смотри по сторонам. Умный человек сначала выбирается на берег, потом уже считает, сколько цветков набрал."
    m_Metadata: {m_Items: []}
  - m_Id: 77000000000000011
    m_Localized: "Что скажешь о таверне?"
    m_Metadata: {m_Items: []}
  - m_Id: 77000000000000012
    m_Localized: "Крыша не течёт, похлёбка горячая, хозяйка сдачу не забывает — уже неплохо. Раньше там к ночи гудело так, что постовые ругались. Сейчас тише. И лучше: пьяный с ножом — та же беда, только сперва песню затянет."
    m_Metadata: {m_Items: []}
  - m_Id: 77000000000000013
    m_Localized: "Почему там почти пусто?"
    m_Metadata: {m_Items: []}
  - m_Id: 77000000000000014
    m_Localized: "Потому что дорога пустая. Путник не дурак: услышал про тварей, разбойников и закрытые ворота — свернул раньше. А без путников таверна держится на местных. У местных монета есть не каждый вечер."
    m_Metadata: {m_Items: []}
  - m_Id: 77000000000000015
    m_Localized: "А деревня у тракта?"
    m_Metadata: {m_Items: []}
  - m_Id: 77000000000000016
    m_Localized: "Нормальная была деревня. Народ работящий, злой ровно настолько, сколько надо, чтобы чужой в огород не лез. Дорога их кормила: подвода сломалась — есть работа, путник остановился — есть хлеб. Теперь ни того, ни другого."
    m_Metadata: {m_Items: []}
  - m_Id: 77000000000000017
    m_Localized: "Туда безопасно идти?"
    m_Metadata: {m_Items: []}
  - m_Id: 77000000000000018
    m_Localized: "Если по дороге — опасно везде. Если спрашиваешь про людей, то не лезь в чужой двор с руками в карманах и не строй из себя господина — разговаривать будут. А что там сейчас, не скажу. Давно оттуда никто к воротам не приходил."
    m_Metadata: {m_Items: []}
  - m_Id: 77000000000000019
    m_Localized: "Что с городом?"
    m_Metadata: {m_Items: []}
  - m_Id: 77000000000000020
    m_Localized: "С городом — приказ. Внутри люди валятся с ног, лекари шепчутся, совет заперся. А мы снаружи держим ворота и слушаем, как нас называют сволочами. Работа дрянь, но кто-то её делать должен."
    m_Metadata: {m_Items: []}
  - m_Id: 77000000000000021
    m_Localized: "Когда ворота откроют?"
    m_Metadata: {m_Items: []}
  - m_Id: 77000000000000022
    m_Localized: "Когда сверху скажут. Я не совет, не лекарь и не провидец. Моё дело — чтобы никто не пролез, пока зараза не решит, что ей тесно за стеной. Не нравится — мне тоже."
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000001
    m_Localized: "\u0415\u0441\u0442\u044C \u0443 \u0432\u0430\u0441 \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u044F?"
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000002
    m_Localized: "\u0415\u0441\u0442\u044C. \u0422\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0434\u0432\u0438\u0433\u0438 \u043D\u0435 \u043E\u0431\u0435\u0449\u0430\u044E: \u0432 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u043C \u0433\u0440\u044F\u0437\u044C, \u0447\u0443\u0436\u0438\u0435 \u0431\u0435\u0434\u044B \u0438 \u0434\u043E\u0440\u043E\u0433\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043D\u043E\u0440\u043E\u0432\u0438\u0442 \u0432\u0437\u044F\u0442\u044C \u0441 \u0442\u0435\u0431\u044F \u043F\u043B\u0430\u0442\u0443 \u0434\u0432\u0430\u0436\u0434\u044B."
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000003
    m_Localized: "\u0427\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C \u0443 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B?"
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000004
    m_Localized: "\u041C\u0435\u043B\u044C\u043D\u0438\u043A \u043E\u0431\u044B\u0447\u043D\u043E \u0440\u0430\u0437 \u0432 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u043D\u0435\u0439 \u0437\u0430\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u043B \u043A \u0432\u043E\u0440\u043E\u0442\u0430\u043C: \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u043B\u0441\u044F \u0437\u0430 \u0441\u043E\u043B\u044C, \u0440\u0443\u0433\u0430\u043B\u0441\u044F \u043D\u0430 \u0446\u0435\u043D\u044B, \u043F\u0440\u0438\u0432\u043E\u0437\u0438\u043B \u043C\u0443\u043A\u0443. \u0423\u0436\u0435 \u0432\u0442\u043E\u0440\u043E\u0439 \u0434\u0435\u043D\u044C \u0435\u0433\u043E \u043D\u0435 \u0432\u0438\u0434\u043D\u043E. \u0410 \u043D\u0430 \u043A\u0430\u0440\u0430\u0443\u043B\u0435 \u0431\u0435\u0437 \u0441\u0432\u0435\u0436\u0435\u0433\u043E \u0445\u043B\u0435\u0431\u0430 \u043B\u044E\u0434\u0438 \u0431\u044B\u0441\u0442\u0440\u043E \u043C\u0440\u0430\u0447\u043D\u0435\u044E\u0442. \u0421\u0445\u043E\u0434\u0438, \u0443\u0437\u043D\u0430\u0439, \u0447\u0442\u043E \u0442\u0430\u043C."
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000005
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0441\u0430\u043C\u0438 \u043D\u0435 \u0441\u0445\u043E\u0434\u0438\u0442\u0435?"
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000006
    m_Localized: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0443 \u043D\u0430\u0441 \u043E\u0434\u043D\u0438 \u043A\u0430\u0440\u0430\u0443\u043B\u044B. \u041B\u044E\u0434\u0435\u0439 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442: \u043E\u0434\u0438\u043D \u0437\u0430\u0431\u043E\u043B\u0435\u043B, \u0434\u0432\u043E\u0438\u0445 \u0441 \u043D\u043E\u0447\u043D\u043E\u0439 \u0441\u043C\u0435\u043D\u044B \u043D\u0435 \u0441\u043D\u0438\u043C\u0435\u0448\u044C, \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u044B\u0439 \u0443\u0436\u0435 \u0432\u0442\u043E\u0440\u043E\u0439 \u0434\u0435\u043D\u044C \u0441\u0442\u043E\u0438\u0442 \u0443 \u0432\u043E\u0440\u043E\u0442. \u042F \u0438 \u0441\u0430\u043C \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0441\u044F \u043A \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0435 \u2014 \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0435 \u044D\u0442\u043E \u043D\u0435 \u043F\u043E\u0445\u043E\u0436\u0435 \u043D\u0430 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0443. \u041D\u043E \u0442\u0443\u0442 \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C \u0432\u044B. \u0423\u0437\u043D\u0430\u0435\u0442\u0435, \u0447\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C, \u2014 \u043D\u0435 \u043E\u0431\u0438\u0436\u0443 \u043D\u0430\u0433\u0440\u0430\u0434\u043E\u0439."
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000007
    m_Localized: "\u041B\u0430\u0434\u043D\u043E. \u0421\u0445\u043E\u0436\u0443 \u043A \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0435."
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000009
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u043E. \u041D\u0435 \u0433\u0435\u0440\u043E\u0439\u0441\u0442\u0432\u0443\u0439\u0442\u0435: \u0441\u043F\u0435\u0440\u0432\u0430 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435, \u0435\u0441\u0442\u044C \u043B\u0438 \u0442\u0430\u043C \u043B\u044E\u0434\u0438, \u0430 \u0443\u0436\u0435 \u043F\u043E\u0442\u043E\u043C \u043B\u0435\u0437\u044C\u0442\u0435 \u0432\u043D\u0443\u0442\u0440\u044C. \u0412\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C \u0441 \u0442\u0435\u043C, \u0447\u0442\u043E \u0443\u0437\u043D\u0430\u0435\u0442\u0435."
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000011
    m_Localized: "\u0427\u0442\u043E \u0437\u0430 \u0434\u0435\u043B\u043E \u0432 \u0442\u0430\u0432\u0435\u0440\u043D\u0435?"
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000012
    m_Localized: "\u0422\u0430\u0432\u0435\u0440\u043D\u0430 \u0443 \u0442\u0440\u0430\u043A\u0442\u0430 \u0440\u0430\u043D\u044C\u0448\u0435 \u0436\u0438\u043B\u0430 \u0448\u0443\u043C\u043E\u043C. \u0422\u0435\u043F\u0435\u0440\u044C \u043E\u0442\u0442\u0443\u0434\u0430 \u0434\u0430\u0432\u043D\u043E \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B, \u0434\u0430\u0436\u0435 \u0437\u0430 \u0441\u043E\u043B\u044C\u044E. \u0425\u043E\u0437\u044F\u0438\u043D \u0441 \u0434\u043E\u0447\u0435\u0440\u044C\u044E \u0434\u0435\u0440\u0436\u0430\u043B\u0438 \u043C\u0435\u0441\u0442\u043E \u043A\u0440\u0435\u043F\u043A\u043E; \u0435\u0441\u043B\u0438 \u043C\u043E\u043B\u0447\u0430\u0442, \u0437\u043D\u0430\u0447\u0438\u0442, \u043B\u0438\u0431\u043E \u0431\u0435\u0434\u0430, \u043B\u0438\u0431\u043E \u0434\u0432\u0435\u0440\u044C \u0437\u0430\u043F\u0435\u0440\u043B\u0438 \u0438\u0437 \u0441\u0442\u0440\u0430\u0445\u0430. \u0417\u0430\u0439\u0434\u0438\u0442\u0435 \u0438 \u0443\u0437\u043D\u0430\u0439\u0442\u0435, \u0432\u0441\u0451 \u043B\u0438 \u0443 \u043D\u0438\u0445 \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435."
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000013
    m_Localized: "\u042D\u0442\u043E \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u0435 \u0434\u043B\u044F \u0441\u0442\u0440\u0430\u0436\u0438 \u0438\u043B\u0438 \u043B\u0438\u0447\u043D\u043E\u0435?"
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000014
    m_Localized: "\u0418 \u0442\u043E \u0438 \u0434\u0440\u0443\u0433\u043E\u0435. \u041F\u0443\u0441\u0442\u0430\u044F \u0442\u0430\u0432\u0435\u0440\u043D\u0430 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 \u2014 \u043F\u043B\u043E\u0445\u043E\u0439 \u0437\u043D\u0430\u043A \u0434\u043B\u044F \u0432\u0441\u0435\u0445. \u0410 \u0434\u043E\u0447\u044C \u0445\u043E\u0437\u044F\u0438\u043D\u0430... \u043E\u043D\u0430 \u0443\u043C\u0435\u0435\u0442 \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0433\u043E\u043B\u043E\u0432\u0443 \u0432\u044B\u0448\u0435 \u0431\u0435\u0434\u044B. \u0425\u043E\u0442\u0435\u043B \u0431\u044B \u0437\u043D\u0430\u0442\u044C, \u0436\u0438\u0432\u0430 \u043B\u0438 \u044D\u0442\u0430 \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0430. \u041D\u0435 \u043F\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0435\u0439 \u043B\u0438\u0448\u043D\u0435\u0433\u043E. \u041F\u0440\u043E\u0441\u0442\u043E \u0443\u0437\u043D\u0430\u0439\u0442\u0435, \u043A\u0430\u043A \u043E\u043D\u0438."
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000015
    m_Localized: "\u0417\u0430\u0439\u0434\u0443 \u0432 \u0442\u0430\u0432\u0435\u0440\u043D\u0443 \u0438 \u0440\u0430\u0441\u0441\u043F\u0440\u043E\u0448\u0443."
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000016
    m_Localized: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E. \u041D\u0435 \u0442\u0440\u0435\u0431\u0443\u0439\u0442\u0435 \u043E\u0442 \u043D\u0438\u0445 \u043E\u0442\u0447\u0451\u0442\u0430, \u043A\u0430\u043A \u043E\u0442 \u0441\u043E\u043B\u0434\u0430\u0442. \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435, \u0447\u0442\u043E \u0443\u0432\u0438\u0434\u0438\u0442\u0435, \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435 \u043F\u043E-\u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438 \u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0442\u0435\u0441\u044C \u0441 \u0432\u0435\u0441\u0442\u044C\u044E."
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000018
    m_Localized: "\u041C\u0435\u043B\u044C\u043D\u0438\u0446\u0430 \u043C\u043E\u043B\u0447\u0438\u0442"
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000019
    m_Localized: "\u0413\u043B\u0430\u0432\u0430 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u0441\u0442\u0440\u0430\u0436\u0438 \u043F\u0440\u043E\u0441\u0438\u0442 \u0432\u044B\u044F\u0441\u043D\u0438\u0442\u044C, \u043F\u043E\u0447\u0435\u043C\u0443 \u043C\u0435\u043B\u044C\u043D\u0438\u043A \u043D\u0435 \u043F\u043E\u044F\u0432\u043B\u044F\u043B\u0441\u044F \u0443 \u0432\u043E\u0440\u043E\u0442 \u0443\u0436\u0435 \u0434\u0432\u0430 \u0434\u043D\u044F."
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000020
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0443"
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000021
    m_Localized: "\u0414\u043E\u0431\u0435\u0440\u0438\u0442\u0435\u0441\u044C \u0434\u043E \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B \u0438 \u0443\u0437\u043D\u0430\u0439\u0442\u0435, \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E \u0441 \u043C\u0435\u043B\u044C\u043D\u0438\u043A\u043E\u043C."
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000022
    m_Localized: "\u0412\u0435\u0441\u0442\u0438 \u0438\u0437 \u0442\u0430\u0432\u0435\u0440\u043D\u044B"
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000023
    m_Localized: "\u0413\u043B\u0430\u0432\u0430 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u0441\u0442\u0440\u0430\u0436\u0438 \u043F\u0440\u043E\u0441\u0438\u0442 \u0443\u0437\u043D\u0430\u0442\u044C, \u0432\u0441\u0451 \u043B\u0438 \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435 \u0443 \u0445\u043E\u0437\u044F\u0438\u043D\u0430 \u0442\u0430\u0432\u0435\u0440\u043D\u044B \u0438 \u0435\u0433\u043E \u0434\u043E\u0447\u0435\u0440\u0438."
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000024
    m_Localized: "\u0417\u0430\u0439\u0442\u0438 \u0432 \u0442\u0430\u0432\u0435\u0440\u043D\u0443"
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000025
    m_Localized: "\u0414\u043E\u0431\u0435\u0440\u0438\u0442\u0435\u0441\u044C \u0434\u043E \u0442\u0430\u0432\u0435\u0440\u043D\u044B \u0443 \u0442\u0440\u0430\u043A\u0442\u0430 \u0438 \u0443\u0437\u043D\u0430\u0439\u0442\u0435, \u0447\u0442\u043E \u0442\u0430\u043C \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442."
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000026
    m_Localized: "\u0410 \u0442\u044B \u0441\u0430\u043C? \u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0435\u0448\u044C \u043E \u0441\u0435\u0431\u0435?"
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000027
    m_Localized: "\u042F? \u0418\u0437 \u043A\u0430\u043D\u0430\u0432\u044B, \u0435\u0441\u043B\u0438 \u043F\u043E \u043F\u0440\u0430\u0432\u0434\u0435. \u041C\u0435\u043D\u044F \u043C\u0430\u043B\u044C\u0446\u043E\u043C \u0443 \u0434\u043E\u0440\u043E\u0433\u0438 \u0431\u0440\u043E\u0441\u0438\u043B\u0438. \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u043E \u0434\u0432\u043E\u0440\u0430\u043C \u043F\u043E\u0431\u0438\u0440\u0430\u043B\u0441\u044F, \u043F\u043E\u0442\u043E\u043C \u0442\u0430\u0441\u043A\u0430\u043B, \u0447\u0442\u043E \u043F\u043B\u043E\u0445\u043E \u043B\u0435\u0436\u0438\u0442. \u041D\u0435 \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0434\u0443\u0448\u0430 \u043A \u0442\u043E\u043C\u0443 \u043B\u0435\u0436\u0430\u043B\u0430 \u2014 \u043F\u0443\u0441\u0442\u043E\u0439 \u0436\u0438\u0432\u043E\u0442 \u0443\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0442 \u043B\u0443\u0447\u0448\u0435 \u043B\u044E\u0431\u043E\u0433\u043E \u0443\u043C\u043D\u0438\u043A\u0430."
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000028
    m_Localized: "\u0418 \u043A\u0430\u043A \u0442\u044B \u0432 \u0441\u0442\u0440\u0430\u0436\u0443 \u043F\u043E\u043F\u0430\u043B?"
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000029
    m_Localized: "\u0412\u044B\u0440\u043E\u0441 \u2014 \u043F\u043E\u043D\u044F\u043B: \u0432\u043E\u0440 \u0438\u0437 \u043C\u0435\u043D\u044F \u0442\u0430\u043A \u0441\u0435\u0431\u0435, \u0434\u0430 \u0438 \u0431\u0435\u0433\u0430\u0442\u044C \u043E\u0442 \u043F\u0430\u043B\u043A\u0438 \u043D\u0430\u0434\u043E\u0435\u043B\u043E. \u041F\u043E\u0442\u043E\u043C \u0432\u0441\u0451 \u0442\u0443\u0442 \u043F\u043E\u043A\u0430\u0442\u0438\u043B\u043E\u0441\u044C: \u0434\u043E\u0440\u043E\u0433\u0438 \u043E\u043F\u0443\u0441\u0442\u0435\u043B\u0438, \u043B\u044E\u0434\u0435\u0439 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442. \u0411\u0440\u0430\u043B\u0438 \u043A\u0430\u0436\u0434\u043E\u0433\u043E, \u043A\u0442\u043E \u043A\u043E\u043F\u044C\u0451 \u043D\u0435 \u0440\u043E\u043D\u044F\u0435\u0442 \u0438 \u0432 \u043F\u0435\u0440\u0432\u0443\u044E \u043D\u043E\u0447\u044C \u043D\u0435 \u0441\u0431\u0435\u0436\u0438\u0442. \u042F \u043E\u0441\u0442\u0430\u043B\u0441\u044F. \u0420\u0430\u0431\u043E\u0442\u0430 \u0434\u0440\u044F\u043D\u044C, \u043D\u043E \u0434\u0435\u043B\u0430\u044E \u043A\u0430\u043A \u0441\u043B\u0435\u0434\u0443\u0435\u0442. \u0427\u0443\u0436\u043E\u0433\u043E \u043D\u0435 \u0431\u0435\u0440\u0443, \u0441\u043B\u0430\u0431\u043E\u0433\u043E \u043D\u0435 \u043F\u0438\u043D\u0430\u044E, \u0441\u043B\u043E\u0432\u043E \u0434\u0435\u0440\u0436\u0443. \u0411\u043E\u043B\u044C\u0448\u0435 \u0443 \u043C\u0435\u043D\u044F \u0437\u0430 \u0434\u0443\u0448\u043E\u0439 \u0438 \u043D\u0435\u0442."
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000030
    m_Localized: "\u041A\u043E\u0436\u0430\u043D\u044B\u0439 \u0434\u043E\u0440\u043E\u0436\u043D\u044B\u0439 \u0434\u0443\u0431\u043B\u0435\u0442"
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000031
    m_Localized: "\u0414\u0443\u0431\u043B\u0435\u0442 \u0438\u0437 \u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u0432\u044B\u0434\u0435\u043B\u0430\u043D\u043D\u043E\u0439 \u043A\u043E\u0436\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043D\u043E\u0441\u044F\u0442 \u043F\u043E\u0432\u0435\u0440\u0445 \u0440\u0443\u0431\u0430\u0445\u0438 \u0432 \u0434\u043E\u0440\u043E\u0433\u0443 \u0438 \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0443. \u041E\u043D \u043D\u0435 \u0434\u0435\u043B\u0430\u0435\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0441\u043E\u043B\u0434\u0430\u0442\u043E\u043C, \u0437\u0430\u0442\u043E \u0431\u0435\u0440\u0435\u0436\u0451\u0442 \u043E\u0434\u0435\u0436\u0434\u0443 \u043E\u0442 \u043C\u043E\u043A\u0440\u043E\u0439 \u0442\u0440\u0430\u0432\u044B, \u0440\u0435\u043C\u043D\u0435\u0439 \u0438 \u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0439 \u043F\u044B\u043B\u0438. \u0428\u0432\u044B \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0434\u043B\u0430\u0442\u0430\u0442\u044C \u0443 \u043B\u044E\u0431\u043E\u0433\u043E \u0441\u043A\u043E\u0440\u043D\u044F\u043A\u0430, \u0430 \u043F\u043E\u0442\u0451\u0440\u0442\u043E\u0441\u0442\u0438 \u043D\u0430 \u0442\u0430\u043A\u043E\u0439 \u043A\u043E\u0436\u0435 \u043D\u0435 \u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0442 \u043F\u043E\u0437\u043E\u0440\u043E\u043C. \u0422\u0430\u043A\u0438\u0435 \u0432\u0435\u0449\u0438 \u0446\u0435\u043D\u044F\u0442 \u043D\u0435 \u0437\u0430 \u043D\u0430\u0440\u044F\u0434\u043D\u043E\u0441\u0442\u044C, \u0430 \u0437\u0430 \u0442\u043E, \u0447\u0442\u043E \u0443\u0442\u0440\u043E\u043C \u0438\u0445 \u0441\u043D\u043E\u0432\u0430 \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0434\u0435\u0442\u044C \u0438 \u0438\u0434\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435."
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000032
    m_Localized: "\u0428\u0430\u043F\u0435\u0440\u043E\u043D \u0441 \u043A\u0440\u0430\u0441\u043D\u044B\u043C \u043F\u0435\u0440\u043E\u043C"
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000033
    m_Localized: "\u0428\u0430\u043F\u0435\u0440\u043E\u043D \u0434\u043B\u044F \u0442\u0435\u0445, \u043A\u0442\u043E \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442 \u0434\u0435\u043D\u044C \u043D\u0430 \u0432\u0435\u0442\u0440\u0443, \u043D\u043E \u043D\u0435 \u0445\u043E\u0447\u0435\u0442 \u043F\u0440\u044F\u0442\u0430\u0442\u044C \u043B\u0438\u0446\u043E \u043F\u043E\u0434 \u043A\u0430\u043F\u044E\u0448\u043E\u043D\u043E\u043C. \u041A\u0440\u0430\u0441\u043D\u043E\u0435 \u043F\u0435\u0440\u043E \u2014 \u0437\u0430\u043C\u0435\u0442\u043D\u0430\u044F, \u043D\u043E \u043D\u0435\u0434\u043E\u0440\u043E\u0433\u0430\u044F \u043F\u043E\u043F\u044B\u0442\u043A\u0430 \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u0442\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C \u0441 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435\u043C; \u0432\u0441\u0451 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435 \u0432 \u043D\u0451\u043C \u043F\u043E\u0434\u0447\u0438\u043D\u0435\u043D\u043E \u0434\u043E\u0440\u043E\u0433\u0435. \u0412 \u043D\u0451\u043C \u0443\u0434\u043E\u0431\u043D\u043E \u0441\u043B\u0443\u0448\u0430\u0442\u044C, \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0438 \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0442\u044C\u0441\u044F, \u0447\u0442\u043E \u0432 \u043F\u0443\u0442\u0438 \u0432\u0430\u0436\u043D\u0435\u0435 \u0432\u0441\u044F\u043A\u043E\u0439 \u043C\u043E\u0434\u044B. \u041D\u0430 \u043F\u0440\u0438\u0451\u043C \u0432 \u0442\u0430\u043A\u043E\u043C \u043D\u0435 \u0438\u0434\u0443\u0442, \u043D\u043E \u0443 \u0432\u043E\u0440\u043E\u0442, \u043D\u0430 \u0440\u044B\u043D\u043A\u0435 \u0438 \u0432 \u0441\u0435\u0434\u043B\u0435 \u043E\u043D \u043D\u0438\u043A\u043E\u0433\u043E \u043D\u0435 \u0443\u0434\u0438\u0432\u0438\u0442."
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000034
    m_Localized: "\u0414\u043E\u0440\u043E\u0436\u043D\u044B\u0435 \u0448\u0442\u0430\u043D\u044B"
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000035
    m_Localized: "\u0428\u0442\u0430\u043D\u044B \u0434\u043B\u044F \u0440\u0430\u0431\u043E\u0442\u044B, \u0430 \u043D\u0435 \u0434\u043B\u044F \u0441\u0443\u043D\u0434\u0443\u043A\u0430. \u041A\u0440\u0435\u043F\u043A\u0430\u044F \u0442\u043A\u0430\u043D\u044C \u0438 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0439 \u043A\u0440\u043E\u0439 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442 \u0434\u043E\u043B\u0433\u043E \u0441\u0438\u0434\u0435\u0442\u044C \u0432 \u0441\u0435\u0434\u043B\u0435, \u0442\u0430\u0441\u043A\u0430\u0442\u044C \u044F\u0449\u0438\u043A\u0438 \u0438\u043B\u0438 \u0441\u0442\u043E\u044F\u0442\u044C \u043D\u0430 \u043F\u043E\u0441\u0442\u0443. \u041A\u043E\u043B\u0435\u043D\u0438 \u0438 \u0448\u0432\u044B \u0437\u0434\u0435\u0441\u044C \u0432\u0430\u0436\u043D\u0435\u0435 \u0440\u0438\u0441\u0443\u043D\u043A\u0430: \u043E\u0434\u0435\u0436\u0434\u0443 \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0447\u0430\u0441\u0442\u043E \u0441\u0442\u0438\u0440\u0430\u0442\u044C, \u0441\u0443\u0448\u0438\u0442\u044C \u0443 \u043E\u0433\u043D\u044F \u0438 \u0447\u0438\u043D\u0438\u0442\u044C \u043D\u0430\u0441\u043F\u0435\u0445. \u0423 \u0445\u043E\u0440\u043E\u0448\u0435\u0433\u043E \u0445\u043E\u0437\u044F\u0438\u043D\u0430 \u0442\u0430\u043A\u0438\u0435 \u0448\u0442\u0430\u043D\u044B \u043D\u0435 \u043B\u0435\u0436\u0430\u0442 \u0431\u0435\u0437 \u0434\u0435\u043B\u0430 \u2014 \u0438\u0445 \u0438\u0437\u043D\u0430\u0448\u0438\u0432\u0430\u044E\u0442 \u0434\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439 \u0437\u0430\u043F\u043B\u0430\u0442\u044B."
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000036
    m_Localized: "\u0421\u0430\u043F\u043E\u0433\u0438 \u0441 \u043E\u0431\u043C\u043E\u0442\u043A\u0430\u043C\u0438"
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000037
    m_Localized: "\u041F\u0430\u0440\u0430 \u0433\u0440\u0443\u0431\u044B\u0445 \u043A\u043E\u0436\u0430\u043D\u044B\u0445 \u0441\u0430\u043F\u043E\u0433 \u0434\u043B\u044F \u0442\u0435\u0445, \u043A\u043E\u043C\u0443 \u0447\u0430\u0441\u0442\u043E \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043C\u0435\u0440\u0438\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u0443 \u043D\u043E\u0433\u0430\u043C\u0438. \u0412\u044B\u0441\u043E\u043A\u0438\u0435 \u0433\u043E\u043B\u0435\u043D\u0438\u0449\u0430 \u0434\u0435\u0440\u0436\u0430\u0442 \u0433\u0440\u044F\u0437\u044C \u0438 \u043A\u043E\u043B\u044E\u0447\u043A\u0438 \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0435 \u043E\u0442 \u043E\u0434\u0435\u0436\u0434\u044B, \u0430 \u043F\u043B\u043E\u0442\u043D\u0430\u044F \u043F\u043E\u0434\u043E\u0448\u0432\u0430 \u0442\u0435\u0440\u043F\u0438\u0442 \u043A\u0430\u043C\u043D\u0438, \u0449\u0435\u0431\u0435\u043D\u044C \u0438 \u043A\u043E\u0440\u043D\u0438. \u0418\u0445 \u043D\u0435 \u0436\u0430\u043B\u0435\u044E\u0442: \u0441\u0443\u0448\u0430\u0442 \u0443 \u043E\u0433\u043D\u044F, \u0441\u043C\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u0436\u0438\u0440\u043E\u043C \u0438 \u0441\u043D\u043E\u0432\u0430 \u0432\u044B\u0432\u043E\u0434\u044F\u0442 \u0432 \u0434\u043E\u0436\u0434\u044C. \u041F\u043E\u043A\u0430 \u043F\u043E\u0434\u043E\u0448\u0432\u0430 \u0446\u0435\u043B\u0430, \u0441\u0430\u043F\u043E\u0433\u0438 \u0447\u0435\u0441\u0442\u043D\u043E \u043E\u0442\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E\u0442 \u0446\u0435\u043D\u0443."
