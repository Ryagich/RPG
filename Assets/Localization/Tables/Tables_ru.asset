    m_Localized: "\u041A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u043A\u043E\u0436\u0430\u043D\u044B\u0439 \u0436\u0430\u043A\u0435\u0442 \u0440\u0430\u0441\u043F\u0430\u0445\u043D\u0443\u0442 \u043F\u043E\u0432\u0435\u0440\u0445 \u0441\u0432\u0435\u0442\u043B\u043E\u0439 \u0440\u0443\u0431\u0430\u0445\u0438 \u0438 \u0441\u0442\u044F\u043D\u0443\u0442 \u0443 \u0433\u0440\u0443\u0434\u0438 \u0442\u043E\u043D\u043A\u0438\u043C\u0438 \u0437\u0430\u0432\u044F\u0437\u043A\u0430\u043C\u0438. \u041E\u0442\u043A\u0440\u044B\u0442\u044B\u0439 \u043F\u0435\u0440\u0435\u0434 \u043D\u0435 \u0441\u043A\u043E\u0432\u044B\u0432\u0430\u0435\u0442 \u0434\u044B\u0445\u0430\u043D\u0438\u0435, \u0430 \u043F\u043B\u043E\u0442\u043D\u044B\u0435 \u043F\u043E\u043B\u044B \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u043F\u043B\u0435\u0447\u0438 \u043E\u0442 \u0432\u0435\u0442\u0440\u0430 \u0432 \u043E\u0431\u044B\u0447\u043D\u044B\u0439 \u0434\u0435\u043D\u044C \u043D\u0430 \u043D\u043E\u0433\u0430\u0445."
