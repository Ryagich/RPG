    m_Localized: "\u0428\u0438\u0440\u043E\u043A\u0430\u044F \u043A\u043E\u0436\u0430\u043D\u0430\u044F \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u044C \u0438\u0434\u0451\u0442 \u043E\u0442 \u043F\u043B\u0435\u0447\u0430 \u043A \u043F\u043E\u044F\u0441\u0443 \u043F\u043E\u0432\u0435\u0440\u0445 \u0440\u0443\u0431\u0430\u0445\u0438. \u041E\u043D\u0430 \u0434\u0435\u0440\u0436\u0438\u0442 \u0437\u0430\u043F\u043B\u0435\u0447\u043D\u0443\u044E \u043D\u043E\u0448\u0443 \u0440\u043E\u0432\u043D\u0435\u0435, \u0430 \u043F\u043E\u0442\u0435\u043C\u043D\u0435\u0432\u0448\u0438\u0435 \u043E\u0442 \u043C\u0430\u0441\u043B\u0430 \u0448\u0432\u044B \u043B\u0435\u0433\u043A\u043E \u043F\u043E\u0434\u043B\u0430\u0442\u0430\u0442\u044C \u0432 \u0434\u043E\u0440\u043E\u0433\u0435."
