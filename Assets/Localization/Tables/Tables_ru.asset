    m_Localized: "\u0414\u043B\u0438\u043D\u043D\u044B\u0435 \u0441\u0432\u0435\u0442\u043B\u044B\u0435 \u043F\u043E\u043B\u043E\u0442\u043D\u0438\u0449\u0430 \u043F\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043D\u044B \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u044B\u043C\u0438 \u043F\u043E\u043B\u043E\u0441\u0430\u043C\u0438, \u0430 \u043D\u0430\u0434 \u0448\u0442\u0430\u043D\u0430\u043C\u0438 \u0432\u0438\u0441\u044F\u0442 \u0442\u0440\u0438 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u043F\u043E\u0434\u0432\u0435\u0441\u043A\u0438. \u041E\u043D\u0438 \u043E\u0436\u0438\u0432\u043B\u044F\u044E\u0442 \u043F\u043E\u044F\u0441, \u043D\u043E \u043D\u0435 \u043C\u0435\u0448\u0430\u044E\u0442 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044E \u0438 \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u044E\u0442 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0442\u044C \u0432\u0441\u044E \u0432\u0435\u0449\u044C \u0432 \u0442\u044F\u0436\u0451\u043B\u043E\u0435 \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u0438\u0435."
