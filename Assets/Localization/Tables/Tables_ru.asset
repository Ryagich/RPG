  - m_Id: 78000000000000038
    m_Localized: "\u0421\u0442\u0451\u0433\u0430\u043D\u044B\u0435 \u043D\u0430\u0440\u0443\u0447\u0438"
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000039
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u0430\u044F \u0437\u0430\u0449\u0438\u0442\u0430 \u043F\u0440\u0435\u0434\u043F\u043B\u0435\u0447\u0438\u0439, \u043A\u043E\u0433\u0434\u0430 \u043B\u0430\u0434\u043E\u043D\u0438 \u0434\u043E\u043B\u0436\u043D\u044B \u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u043C\u0438. \u0421\u0442\u0451\u0433\u0430\u043D\u0430\u044F \u0442\u043A\u0430\u043D\u044C \u0441\u043C\u044F\u0433\u0447\u0438\u0442 \u0441\u043A\u043E\u043B\u044C\u0437\u044F\u0449\u0438\u0439 \u0443\u0434\u0430\u0440, \u0443\u0434\u0435\u0440\u0436\u0438\u0442 \u0440\u0435\u043C\u0435\u043D\u044C \u0449\u0438\u0442\u0430 \u0438 \u043F\u0440\u0438\u043A\u0440\u043E\u0435\u0442 \u0440\u0443\u043A\u0438 \u043E\u0442 \u0433\u0440\u0443\u0431\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B; \u043A\u043E\u0436\u0430\u043D\u044B\u0435 \u0437\u0430\u0441\u0442\u0451\u0436\u043A\u0438 \u043D\u0435 \u0434\u0430\u0434\u0443\u0442 \u043D\u0430\u0440\u0443\u0447\u0430\u043C \u0441\u043F\u043E\u043B\u0437\u0430\u0442\u044C. \u041E\u043D\u0438 \u043D\u0435 \u0437\u0430\u043C\u0435\u043D\u044F\u0442 \u043F\u043E\u043B\u043D\u043E\u0446\u0435\u043D\u043D\u044B\u0435 \u043B\u0430\u0442\u043D\u044B\u0435 \u0440\u0443\u043A\u0430\u0432\u0438\u0446\u044B, \u043D\u043E \u0438 \u0441\u0442\u043E\u044F\u0442 \u043D\u0435 \u043A\u0430\u043A \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u0435 \u0440\u044B\u0446\u0430\u0440\u044F. \u0422\u0430\u043A\u0438\u0435 \u0432\u0435\u0449\u0438 \u043D\u0430\u0434\u0435\u0432\u0430\u044E\u0442 \u043D\u0435 \u0440\u0430\u0434\u0438 \u0432\u0438\u0434\u0430, \u0430 \u043A\u043E\u0433\u0434\u0430 \u0437\u043D\u0430\u044E\u0442, \u0447\u0442\u043E \u0434\u0435\u043D\u044C \u043C\u043E\u0436\u0435\u0442 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C\u0441\u044F \u0441\u0441\u0430\u0434\u0438\u043D\u043E\u0439 \u0438\u043B\u0438 \u0434\u0440\u0430\u043A\u043E\u0439."
