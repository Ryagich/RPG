  - m_Id: 79000000000000046
    m_Localized: "\u041F\u0440\u044F\u043C\u0430\u044F \u0441\u0432\u0435\u0442\u043B\u0430\u044F \u0442\u0443\u043D\u0438\u043A\u0430 \u0441 \u0443\u0437\u043A\u043E\u0439 \u0442\u0451\u043C\u043D\u043E\u0439 \u043A\u0430\u0439\u043C\u043E\u0439 \u0443 \u0432\u043E\u0440\u043E\u0442\u0430 \u0438 \u0448\u0438\u0440\u043E\u043A\u0438\u043C \u043F\u043E\u044F\u0441\u043E\u043C \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043E\u0441\u043E\u0431\u043E\u0433\u043E \u0443\u0445\u043E\u0434\u0430. \u041E\u0442\u043A\u0440\u044B\u0442\u044B\u0435 \u043F\u043B\u0435\u0447\u0438 \u0443\u0434\u043E\u0431\u043D\u044B \u0432 \u0442\u0435\u043F\u043B\u0435, \u0430 \u0434\u043B\u0438\u043D\u043D\u044B\u0439 \u043F\u043E\u0434\u043E\u043B \u0431\u0435\u0440\u0435\u0436\u0451\u0442 \u043D\u0438\u0436\u043D\u044E\u044E \u043E\u0434\u0435\u0436\u0434\u0443 \u043E\u0442 \u043F\u044B\u043B\u0438."
