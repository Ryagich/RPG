  - m_Id: 83000000000000016
    m_Localized: "\u0412\u044B\u0441\u043E\u043A\u0438\u0439 \u0441\u0442\u0435\u0431\u0435\u043B\u044C \u0441 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u043C\u0438 \u0444\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u044B\u043C\u0438 \u0446\u0432\u0435\u0442\u043A\u0430\u043C\u0438 \u0437\u0430\u043C\u0435\u0442\u0435\u043D \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430, \u043D\u043E \u043E\u0431\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F \u0441 \u043D\u0438\u043C \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E. \u0412 \u0442\u0440\u0430\u0432\u043D\u0438\u0447\u044C\u0438\u0445 \u043A\u043D\u0438\u0433\u0430\u0445 \u0436\u0438\u0432\u043E\u043A\u043E\u0441\u0442\u044C \u0447\u0438\u0441\u043B\u0438\u0442\u0441\u044F \u0441\u0438\u043B\u044C\u043D\u044B\u043C \u0438 \u043E\u043F\u0430\u0441\u043D\u044B\u043C \u0441\u044B\u0440\u044C\u0451\u043C: \u0437\u043D\u0430\u044E\u0449\u0438\u0439 \u043B\u0435\u043A\u0430\u0440\u044C \u0431\u0435\u0440\u0451\u0442 \u043B\u0438\u0448\u044C \u043C\u0430\u043B\u0443\u044E \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u043D\u0443\u044E \u0434\u043E\u043B\u044E \u0434\u043B\u044F \u043D\u0430\u0440\u0443\u0436\u043D\u043E\u0439 \u0441\u043C\u0435\u0441\u0438, \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0439 \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0441\u0438\u043B\u044B \u043F\u043E\u0441\u043B\u0435 \u0443\u0448\u0438\u0431\u0430. \u0416\u0435\u0432\u0430\u0442\u044C \u0446\u0432\u0435\u0442\u043E\u043A \u0438\u043B\u0438 \u0431\u0440\u043E\u0441\u0430\u0442\u044C \u0435\u0433\u043E \u0432 \u043F\u043E\u0445\u043E\u0434\u043D\u044B\u0439 \u0447\u0430\u0439 \u2014 \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0430, \u0437\u0430 \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043D\u0435\u0440\u0430\u0437\u0443\u043C\u043D\u044B\u0435 \u043F\u043B\u0430\u0442\u044F\u0442 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435\u043C."
