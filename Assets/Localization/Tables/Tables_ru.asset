  - m_Id: 80000000000000044
    m_Localized: "\u0414\u043B\u0438\u043D\u043D\u044B\u0439 \u043F\u0435\u0440\u0435\u0434\u043D\u0438\u0439 \u0449\u0438\u0442\u043E\u043A \u0441\u043E\u0431\u0440\u0430\u043D \u0438\u0437 \u0441\u0432\u0435\u0442\u043B\u043E\u0439 \u043A\u0430\u0439\u043C\u044B \u0438 \u043F\u043B\u043E\u0442\u043D\u043E\u0439 \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u043E\u0439 \u0432\u0441\u0442\u0430\u0432\u043A\u0438, \u0430 \u0443 \u043F\u043E\u044F\u0441\u0430 \u0435\u0433\u043E \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0448\u0438\u0440\u043E\u043A\u0430\u044F \u043D\u0430\u043A\u043B\u0430\u0434\u043A\u0430. \u041E\u043D \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043F\u0435\u0440\u0435\u0434 \u0431\u0451\u0434\u0435\u0440 \u043E\u0442 \u0440\u0435\u043C\u043D\u0435\u0439 \u0438 \u0443\u0434\u0430\u0440\u043E\u0432 \u043E \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u0435, \u043E\u0441\u0442\u0430\u0432\u0430\u044F\u0441\u044C \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0443\u0437\u043A\u0438\u043C \u0434\u043B\u044F \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0433\u043E \u0448\u0430\u0433\u0430."
