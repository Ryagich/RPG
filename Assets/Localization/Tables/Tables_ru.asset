    m_Localized: "\u0421\u0432\u043E\u0431\u043E\u0434\u043D\u0430\u044F \u0441\u0435\u0440\u0430\u044F \u0440\u0443\u0431\u0430\u0445\u0430 \u0441 \u043A\u043E\u0436\u0430\u043D\u044B\u043C \u043F\u043E\u044F\u0441\u043E\u043C \u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u043C\u0438 \u0440\u0435\u043C\u043D\u044F\u043C\u0438 \u043D\u0430 \u043F\u043B\u0435\u0447\u0430\u0445 \u043D\u0435 \u0441\u0442\u0435\u0441\u043D\u044F\u0435\u0442 \u0441\u043F\u0438\u043D\u0443. \u041D\u0430 \u043D\u0435\u0439 \u0431\u044B\u0441\u0442\u0440\u043E \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u0441\u043B\u0435\u0434\u044B \u0442\u0440\u0443\u0434\u0430, \u0437\u0430\u0442\u043E \u0435\u0451 \u043B\u0435\u0433\u043A\u043E \u0432\u044B\u0441\u0442\u0438\u0440\u0430\u0442\u044C, \u0432\u044B\u0441\u0443\u0448\u0438\u0442\u044C \u0438 \u0441\u043D\u043E\u0432\u0430 \u043D\u0430\u0434\u0435\u0442\u044C \u043D\u0430\u0443\u0442\u0440\u043E."
    m_Metadata: {m_Items: []}
  - m_Id: 79000000000000033
    m_Localized: "\u0422\u0443\u043D\u0438\u043A\u0430 \u0441 \u0441\u0438\u043D\u0435\u0439 \u043E\u043F\u043E\u044F\u0441\u043A\u043E\u0439"
    m_Metadata: {m_Items: []}
  - m_Id: 79000000000000034
    m_Localized: "\u041D\u0435\u0431\u0440\u043E\u0441\u043A\u0430\u044F \u0442\u0443\u043D\u0438\u043A\u0430 \u0441 \u0434\u0438\u0430\u0433\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0439 \u043A\u043E\u0436\u0430\u043D\u043E\u0439 \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u044C\u044E \u0438 \u0448\u0438\u0440\u043E\u043A\u043E\u0439 \u0441\u0438\u043D\u0435\u0439 \u043E\u043F\u043E\u044F\u0441\u043A\u043E\u0439. \u041F\u0435\u0440\u0435\u0432\u044F\u0437\u044C \u0440\u0430\u0437\u0433\u0440\u0443\u0436\u0430\u0435\u0442 \u043F\u043B\u0435\u0447\u043E, \u0430 \u043F\u043B\u043E\u0442\u043D\u0430\u044F \u0442\u043A\u0430\u043D\u044C \u043F\u043E\u044F\u0441\u0430 \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442 \u043E\u0434\u0435\u0436\u0434\u0443 \u043E\u0442 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E\u0433\u043E \u0442\u0440\u0435\u043D\u0438\u044F \u0440\u0435\u043C\u043D\u044F."
    m_Metadata: {m_Items: []}
  - m_Id: 79000000000000035
