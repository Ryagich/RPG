  - m_Id: 82000000000000002
    m_Localized: "\u0421\u0432\u0435\u0442\u043B\u044B\u0435 \u043C\u043D\u043E\u0433\u043E\u0441\u043B\u043E\u0439\u043D\u044B\u0435 \u043D\u0430\u0440\u0443\u0447\u0438 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u043F\u0440\u0435\u0434\u043F\u043B\u0435\u0447\u044C\u044F, \u0430 \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u044B\u0435 \u043A\u043E\u0436\u0430\u043D\u044B\u0435 \u0447\u0430\u0441\u0442\u0438 \u0441\u0442\u044F\u043D\u0443\u0442\u044B \u0440\u0435\u043C\u043D\u044F\u043C\u0438 \u0438 \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u044B \u0440\u043E\u043C\u0431\u043E\u0432\u0438\u0434\u043D\u044B\u043C\u0438 \u043D\u0430\u043A\u043B\u0430\u0434\u043A\u0430\u043C\u0438. \u0421\u0431\u043E\u0440\u043D\u044B\u0439 \u043A\u0440\u043E\u0439 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043B\u043E\u043A\u0442\u0438 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u043C\u0438 \u0438 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0451\u043D\u043D\u044B\u0439 \u0440\u0435\u043C\u0435\u043D\u044C, \u043D\u0435 \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u044F \u0432\u0441\u044E \u0432\u0435\u0449\u044C."
