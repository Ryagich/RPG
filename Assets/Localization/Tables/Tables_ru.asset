    m_Localized: "\u041F\u043E\u043B\u0443\u0447\u0438\u043B \u0437\u0430\u0434\u0430\u043D\u0438\u0435
      \u0441\u043A\u0435\u043B\u0435\u0442\u0430. \u0427\u0422\u043E \u0442\u044B
      \u0431\u043B\u044F\u0442\u044C \u043D\u0430\u0434\u0435\u043B\u0430. \u041C\u041C\u041C
      \u0430 \u0432\u043E\u043E\u0431\u0449\u0435 \u043D\u0430\u0439\u0441 \u043B\u0443\u043A."
    m_Metadata:
      m_Items: []
