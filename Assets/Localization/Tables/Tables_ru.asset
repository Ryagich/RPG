      \u0437\u0430\u0434\u0430\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 20000000000000004
    m_Localized: "\u0412\u0441\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 30000000000000001
    m_Localized: "\u0423\u0432\u043E\u0440\u043E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 30000000000000002
    m_Localized: "\u041A\u0443\u0432\u044B\u0440\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 40000000000000001
    m_Localized: "\u0421\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u043D\u044B\u0435
      \u043B\u044C\u0432\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 40000000000000002
    m_Localized: "\u0411\u0430\u043D\u0434\u0438\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 50000000000000001
    m_Localized: "\u0425\u043E\u0442\u0438\u0442\u0435 \u043F\u0435\u0440\u0435\u0439\u0442\u0438
      \u043D\u0430 \u0434\u0440\u0443\u0433\u0443\u044E \u043B\u043E\u043A\u0430\u0446\u0438\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 50000000000000002
    m_Localized: "\u0414\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 50000000000000003
    m_Localized: "\u041D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 60000000000000001
    m_Localized: "\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0441\u043B\u0430\u0439\u0434
      \u2014 \u043B\u044E\u0431\u0430\u044F \u043A\u043B\u0430\u0432\u0438\u0448\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 60000000000000002
    m_Localized: "\u0423\u0434\u0435\u0440\u0436. \u043F\u0440\u043E\u0431\u0435\u043B
      \u2014 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 60000000000000010
    m_Localized: "\u0422\u0430 \u0434\u0435\u0440\u0436\u0430\u0432\u0430 \u0440\u0430\u0441\u043F\u0430\u043B\u0430\u0441\u044C
      \u0442\u0430\u043A \u0434\u0430\u0432\u043D\u043E, \u0447\u0442\u043E \u0434\u0430\u0436\u0435
      \u0435\u0451 \u0438\u043C\u044F \u0434\u043E\u0448\u043B\u043E \u0434\u043E
      \u043D\u0430\u0441 \u0432 \u0434\u0435\u0441\u044F\u0442\u043A\u0430\u0445
      \u0440\u0430\u0437\u043D\u044B\u0445 \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u0438\u0439.\n\u041D\u043E
      \u0435\u0451 \u0434\u043E\u0440\u043E\u0433\u0438 \u0435\u0449\u0451 \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u044E\u0442
      \u043D\u044B\u043D\u0435\u0448\u043D\u0438\u0435 \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u0430.
      \u041F\u043E \u0435\u0451 \u043C\u043E\u0441\u0442\u0430\u043C \u0432\u0435\u0437\u0443\u0442
      \u0434\u0430\u043D\u044C, \u0432 \u0435\u0451 \u043A\u0440\u0435\u043F\u043E\u0441\u0442\u044F\u0445
      \u0441\u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F \u0433\u0435\u0440\u0431\u044B,
      \u0430 \u043A\u0430\u043C\u043D\u0438 \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u0441\u0442\u0430\u0440\u0435\u0435 \u043B\u044E\u0431\u043E\u0439 \u0438\u0437
      \u043F\u0440\u0430\u0432\u044F\u0449\u0438\u0445 \u0434\u0438\u043D\u0430\u0441\u0442\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 60000000000000011
    m_Localized: "\u041E\u0442 \u043F\u0440\u0435\u0436\u043D\u0435\u0439 \u0434\u0435\u0440\u0436\u0430\u0432\u044B
      \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432 \u2014 \u0438
      \u043A\u0430\u0436\u0434\u043E\u0435 \u0441\u0447\u0438\u0442\u0430\u0435\u0442
      \u0441\u0435\u0431\u044F \u0435\u0451 \u0437\u0430\u043A\u043E\u043D\u043D\u044B\u043C
      \u043D\u0430\u0441\u043B\u0435\u0434\u043D\u0438\u043A\u043E\u043C.\n\u041F\u0440\u0438
      \u0434\u0432\u043E\u0440\u0430\u0445 \u0445\u0440\u0430\u043D\u044F\u0442 \u0440\u0430\u0437\u043D\u044B\u0435
      \u0440\u043E\u0434\u043E\u0441\u043B\u043E\u0432\u043D\u044B\u0435. \u0412
      \u0445\u0440\u0430\u043C\u0430\u0445 \u0447\u0438\u0442\u0430\u044E\u0442 \u0440\u0430\u0437\u043D\u044B\u0435
      \u043B\u0435\u0442\u043E\u043F\u0438\u0441\u0438. \u041D\u0430 \u0441\u0442\u0430\u0440\u044B\u0445
      \u043A\u0430\u0440\u0442\u0430\u0445 \u043E\u0434\u043D\u0438 \u0438 \u0442\u0435
      \u0436\u0435 \u0437\u0435\u043C\u043B\u0438 \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u0442
      \u0441\u0440\u0430\u0437\u0443 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u043C
      \u043A\u043E\u0440\u043E\u043D\u0430\u043C.\n\u0417\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0443\u044E
      \u0436\u0438\u0437\u043D\u044C \u0433\u0440\u0430\u043D\u0438\u0446\u044B \u0437\u0434\u0435\u0441\u044C
      \u0443\u0441\u043F\u0435\u0432\u0430\u044E\u0442 \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C\u0441\u044F
      \u043D\u0435 \u0440\u0430\u0437.\n\u041C\u0435\u043D\u044F\u044E\u0442\u0441\u044F
      \u0433\u0435\u0440\u0431\u044B \u043D\u0430\u0434 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u043C\u0438
      \u2014 \u0438 \u0441\u043B\u043E\u0432\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u043C\u0438
      \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u044E\u0442 \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u0443\u044E
      \u0432\u043E\u0439\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 60000000000000012
    m_Localized: "\u0412\u043E\u0439\u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430
      \u043D\u0430\u0445\u043E\u0434\u044F\u0442 \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u043E\u0435
      \u0438\u043C\u044F: \u0434\u0440\u0435\u0432\u043D\u0435\u0435 \u043F\u0440\u0430\u0432\u043E,
      \u043F\u043E\u0440\u0443\u0433\u0430\u043D\u043D\u0430\u044F \u043A\u043B\u044F\u0442\u0432\u0430,
      \u0447\u0435\u0441\u0442\u044C \u043A\u043E\u0440\u043E\u043D\u044B.\n\u041D\u043E
      \u043F\u043B\u0430\u0442\u044F\u0442 \u0437\u0430 \u043D\u0435\u0451 \u043D\u0435
      \u043F\u0440\u0438 \u0434\u0432\u043E\u0440\u0435. \u0418\u0437 \u0434\u0435\u0440\u0435\u0432\u0435\u043D\u044C
      \u0443\u0432\u043E\u0434\u044F\u0442 \u043B\u044E\u0434\u0435\u0439 \u0438
      \u043B\u043E\u0448\u0430\u0434\u0435\u0439, \u0441\u043E \u0434\u0432\u043E\u0440\u043E\u0432
      \u2014 \u0437\u0435\u0440\u043D\u043E, \u0438\u0437 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0438\u0445
      \u2014 \u0436\u0435\u043B\u0435\u0437\u043E.\n\u041F\u043E\u0431\u0435\u0434\u0430
      \u043F\u0440\u0438\u0431\u0430\u0432\u043B\u044F\u0435\u0442 \u0433\u043E\u0441\u043F\u043E\u0434\u0430\u043C
      \u0437\u0435\u043C\u043B\u0438 \u0438 \u0434\u0430\u043D\u044C. \u041F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435
      \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442 \u043D\u043E\u0432\u044B\u0435
      \u043F\u043E\u0431\u043E\u0440\u044B.\n\u041C\u0438\u0440\u043D\u044B\u0439
      \u0434\u043E\u0433\u043E\u0432\u043E\u0440 \u043C\u0435\u043D\u044F\u0435\u0442
      \u0433\u0440\u0430\u043D\u0438\u0446\u044B. \u0421\u0447\u0451\u0442 \u0437\u0430
      \u0432\u043E\u0439\u043D\u0443 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u043F\u0440\u0435\u0436\u043D\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 60000000000000013
    m_Localized: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044E\u044E \u0432\u043E\u0439\u043D\u0443
      \u043E\u0431\u044A\u044F\u0432\u0438\u043B\u0438 \u0442\u043E\u0440\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E.
      \u0412 \u0445\u0440\u0430\u043C\u0430\u0445 \u0441\u043B\u0443\u0436\u0438\u043B\u0438
      \u043C\u043E\u043B\u0435\u0431\u043D\u044B, \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u044F\u0445
      \u0447\u0438\u0442\u0430\u043B\u0438 \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u0438\u0435
      \u0433\u0440\u0430\u043C\u043E\u0442\u044B, \u043D\u0430\u0434 \u0432\u043E\u0439\u0441\u043A\u043E\u043C
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u043B\u0438 \u0441\u0432\u044F\u0442\u044B\u043D\u0438.\n\u0427\u0435\u0440\u0435\u0437
      \u043C\u0435\u0441\u044F\u0446 \u0432 \u0442\u044B\u043B \u043F\u043E\u0432\u0435\u0437\u043B\u0438
      \u043F\u0435\u0440\u0432\u044B\u0445 \u0431\u043E\u043B\u044C\u043D\u044B\u0445.\n\u041A
      \u043B\u0435\u0442\u0443 \u043C\u043E\u0440 \u0448\u0451\u043B \u0443\u0436\u0435
      \u0432\u043F\u0435\u0440\u0435\u0434\u0438 \u043F\u043E\u043B\u043A\u043E\u0432.
      \u041F\u043E\u0445\u043E\u0434 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u043B\u0441\u044F.\n\u0423
      \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u0445 \u0432\u043E\u0440\u043E\u0442
      \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u043B\u0438
      \u0443\u0436\u0435 \u043D\u0435 \u0447\u0443\u0436\u0438\u0435 \u0432\u043E\u0439\u0441\u043A\u0430,
      \u0430 \u0441\u0432\u043E\u0438. \u041A \u043E\u0441\u0435\u043D\u0438 \u0432
      \u0434\u043E\u043D\u0435\u0441\u0435\u043D\u0438\u044F\u0445 \u0441\u0447\u0438\u0442\u0430\u043B\u0438
      \u043D\u0435 \u0432\u0437\u044F\u0442\u044B\u0435 \u043A\u0440\u0435\u043F\u043E\u0441\u0442\u0438,
      \u0430 \u043E\u043F\u0443\u0441\u0442\u0435\u0432\u0448\u0438\u0435 \u0441\u0435\u043B\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 60000000000000014
    m_Localized: "\u0414\u043E\u0440\u043E\u0433\u0438, \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0448\u0438\u0435
      \u0434\u0440\u0435\u0432\u043D\u044E\u044E \u0434\u0435\u0440\u0436\u0430\u0432\u0443
      \u0438 \u0441\u043E\u0442\u043D\u0438 \u0432\u043E\u0439\u043D, \u043E\u043F\u0443\u0441\u0442\u0435\u043B\u0438
      \u0437\u0430 \u043E\u0434\u043D\u0443 \u0437\u0438\u043C\u0443.\n\u041D\u0430
      \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u0445 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B\u0438
      \u0443\u0436\u0435 \u043D\u0435 \u0438\u043C\u044F \u0438 \u043D\u0435 \u0434\u0435\u043B\u043E,
      \u0430 \u043E\u0442\u043A\u0443\u0434\u0430 \u043F\u0440\u0438\u0448\u0451\u043B
      \u0438 \u0433\u0434\u0435 \u043D\u043E\u0447\u0435\u0432\u0430\u043B. \u0412\u043E\u0440\u043E\u0442\u0430
      \u0437\u0430\u043F\u0438\u0440\u0430\u043B\u0438 \u0435\u0449\u0451 \u0434\u043E
      \u0437\u0430\u043A\u0430\u0442\u0430; \u043E\u043F\u043E\u0437\u0434\u0430\u0432\u0448\u0438\u0445
      \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B\u0438 \u043F\u043E\u0434 \u0441\u0442\u0435\u043D\u0430\u043C\u0438.\n\u041E\u0431\u043E\u0437\u044B
      \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u043B\u0438,
      \u043F\u0438\u0441\u044C\u043C\u0430 \u0436\u0433\u043B\u0438 \u043D\u0435\u0440\u0430\u0441\u043F\u0435\u0447\u0430\u0442\u0430\u043D\u043D\u044B\u043C\u0438,
      \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u044B\u0435 \u0434\u0432\u043E\u0440\u044B
      \u043F\u0443\u0441\u0442\u0435\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 60000000000000015
    m_Localized: "\u0417\u0430\u0442\u0435\u043C \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u0438\u0441\u044C
      \u043B\u0435\u0441\u0430.\n\u041F\u0442\u0438\u0446\u044B \u0441\u043C\u043E\u043B\u043A\u043B\u0438.
      \u0417\u0432\u0435\u0440\u044C \u0441\u043E\u0448\u0451\u043B \u0441 \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u044B\u0445
      \u0442\u0440\u043E\u043F, \u0430 \u043B\u043E\u0448\u0430\u0434\u0438 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u043B\u0438\u0441\u044C
      \u043F\u0435\u0440\u0435\u0434 \u043F\u0443\u0441\u0442\u044B\u043C\u0438 \u043F\u0440\u043E\u0441\u0435\u043A\u0430\u043C\u0438
      \u0438 \u043D\u0435 \u0448\u043B\u0438 \u0434\u0430\u043B\u044C\u0448\u0435
      \u043D\u0438 \u043A\u043D\u0443\u0442\u043E\u043C, \u043D\u0438 \u043F\u043E\u0432\u043E\u0434\u043E\u043C.\n\u041B\u044E\u0434\u0438
      \u0441\u0442\u0430\u043B\u0438 \u043F\u0440\u043E\u043F\u0430\u0434\u0430\u0442\u044C.
      \u0418\u043D\u044B\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u043B\u0438\u0441\u044C
      \u0447\u0435\u0440\u0435\u0437 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0434\u043D\u0435\u0439 \u2014 \u043C\u043E\u043B\u0447\u0430\u043B\u0438\u0432\u044B\u0435,
      \u0441 \u0447\u0443\u0436\u0438\u043C \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C.
      \u0418\u043D\u044B\u0435 \u043D\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u043B\u0438\u0441\u044C
      \u0432\u043E\u0432\u0441\u0435.\n\u041A \u0438\u0441\u0445\u043E\u0434\u0443
      \u0437\u0438\u043C\u044B \u043F\u0438\u0441\u0446\u044B \u0432\u043D\u043E\u0432\u044C
      \u0432\u044B\u0432\u0435\u043B\u0438 \u0432 \u0434\u043E\u043D\u0435\u0441\u0435\u043D\u0438\u044F\u0445
      \u0441\u043B\u043E\u0432\u043E, \u0434\u0430\u0432\u043D\u043E \u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u0435
      \u0441\u043A\u0430\u0437\u043A\u0430\u043C: \u0447\u0443\u0434\u043E\u0432\u0438\u0449\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 60000000000000016
    m_Localized: "\u0421\u0442\u0440\u0430\u0445 \u0431\u044B\u0441\u0442\u0440\u043E
      \u043D\u0430\u0448\u0451\u043B \u0441\u0435\u0431\u0435 \u0442\u043E\u043B\u043A\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u0439.\n\u0421
      \u0430\u043C\u0432\u043E\u043D\u043E\u0432 \u043C\u043E\u0440 \u043E\u0431\u044A\u044F\u0432\u043B\u044F\u043B\u0438
      \u043D\u0435\u0431\u0435\u0441\u043D\u043E\u0439 \u043A\u0430\u0440\u043E\u0439;
      \u0432 \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u0438\u0445 \u0433\u0440\u0430\u043C\u043E\u0442\u0430\u0445
      \u2014 \u0437\u0430\u0440\u0430\u0437\u043E\u0439, \u0437\u0430\u043D\u0435\u0441\u0451\u043D\u043D\u043E\u0439
      \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u043E\u0439 \u0440\u0443\u043A\u043E\u0439.\n\u041B\u0435\u043A\u0430\u0440\u0438
      \u043F\u0440\u043E\u0441\u0438\u043B\u0438 \u043D\u0435 \u0441\u0436\u0438\u0433\u0430\u0442\u044C
      \u0443\u043C\u0435\u0440\u0448\u0438\u0445 \u0434\u043E \u043E\u0441\u043C\u043E\u0442\u0440\u0430.
      \u0421\u0432\u044F\u0449\u0435\u043D\u043D\u0438\u043A\u0438 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043B\u0438
      \u043E\u0433\u043D\u044F \u043F\u0440\u0435\u0436\u0434\u0435 \u043D\u0430\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u044F
      \u043D\u043E\u0447\u0438.\n\u0420\u044B\u0446\u0430\u0440\u0441\u043A\u0438\u0435
      \u043E\u0440\u0434\u0435\u043D\u044B \u0443\u0445\u043E\u0434\u0438\u043B\u0438
      \u043D\u0430 \u0441\u0442\u0430\u0440\u044B\u0435 \u0434\u043E\u0440\u043E\u0433\u0438
      \u0438 \u0432 \u043B\u0435\u0441\u043D\u044B\u0435 \u0447\u0430\u0449\u0438.
      \u0418\u0437 \u0438\u043D\u044B\u0445 \u043F\u043E\u0445\u043E\u0434\u043E\u0432
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u043B\u0438\u0441\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u043A\u043E\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 60000000000000017
    m_Localized: "\u0422\u0430\u043C, \u0433\u0434\u0435 \u043D\u0435 \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438
      \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430, \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438
      \u0432\u0438\u043D\u043E\u0432\u043D\u044B\u0445.\n\u0421\u043F\u0435\u0440\u0432\u0430
      \u0431\u0440\u0430\u043B\u0438 \u043F\u0440\u0438\u0448\u043B\u044B\u0445 \u0438
      \u043D\u0438\u0449\u0438\u0445. \u041F\u043E\u0441\u043B\u0435 \u2014 \u043D\u0435\u043B\u044E\u0434\u0435\u0439,
      \u0435\u0440\u0435\u0442\u0438\u043A\u043E\u0432, \u0437\u043D\u0430\u0445\u0430\u0440\u0435\u0439.\n\u041D\u0430
      \u0434\u0432\u0435\u0440\u044F\u0445 \u0441\u0442\u0430\u0432\u0438\u043B\u0438
      \u043C\u0435\u0442\u044B, \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u044F\u0445
      \u0447\u0438\u0442\u0430\u043B\u0438 \u0438\u043C\u0435\u043D\u0430, \u043F\u043E
      \u043D\u043E\u0447\u0430\u043C \u043F\u0443\u0441\u0442\u0435\u043B\u0438 \u0446\u0435\u043B\u044B\u0435
      \u0434\u0432\u043E\u0440\u044B.\n\u041C\u043E\u0440 \u043D\u0435 \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 60000000000000018
    m_Localized: "\u0412\u0441\u043A\u043E\u0440\u0435 \u0437\u0430\u043F\u0435\u0440\u0441\u044F
      \u0438 \u0433\u043E\u0440\u043E\u0434 \u0443 \u0441\u0442\u0430\u0440\u043E\u0433\u043E
      \u0442\u0440\u0430\u043A\u0442\u0430.\n\u041E\u043A\u0440\u0435\u0441\u0442\u043D\u044B\u0435
      \u0434\u0435\u0440\u0435\u0432\u043D\u0438 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C
      \u0431\u0435\u0437 \u0442\u043E\u0440\u0433\u0430 \u0438 \u0437\u0430\u0449\u0438\u0442\u044B.
      \u041F\u043E\u0441\u0442\u043E\u044F\u043B\u044B\u0435 \u0434\u0432\u043E\u0440\u044B
      \u043E\u043F\u0443\u0441\u0442\u0435\u043B\u0438, \u043B\u0435\u0441\u043D\u044B\u0435
      \u0434\u043E\u0440\u043E\u0433\u0438 \u043E\u0442\u043E\u0448\u043B\u0438 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0430\u043C."
