  - m_Id: 79000000000000048
    m_Localized: "\u0421\u0432\u0435\u0442\u043B\u0430\u044F \u043C\u043D\u043E\u0433\u043E\u0441\u043B\u043E\u0439\u043D\u0430\u044F \u043A\u0443\u0440\u0442\u043A\u0430 \u0441 \u0432\u044B\u0441\u043E\u043A\u0438\u043C \u0432\u043E\u0440\u043E\u0442\u043E\u043C \u0438 \u0442\u0451\u043C\u043D\u043E\u0439 \u043E\u0442\u0434\u0435\u043B\u043A\u043E\u0439 \u043F\u043B\u043E\u0442\u043D\u043E \u0441\u043E\u0431\u0440\u0430\u043D\u0430 \u0432\u043E\u043A\u0440\u0443\u0433 \u0433\u0440\u0443\u0434\u0438. \u0423\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0435 \u043F\u043E\u043B\u043E\u0442\u043D\u0438\u0449\u0430 \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442 \u0435\u0439 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0442\u044C \u043E\u043F\u0440\u044F\u0442\u043D\u043E\u0441\u0442\u044C \u0432 \u0441\u044B\u0440\u043E\u0439 \u0434\u0435\u043D\u044C \u0438 \u0432\u044B\u0434\u0430\u044E\u0442 \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0446\u0435\u043D\u0438\u0442 \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E\u0441\u0442\u044C \u0431\u0435\u0437 \u0438\u0437\u043B\u0438\u0448\u043D\u0435\u0439 \u0440\u043E\u0441\u043A\u043E\u0448\u0438."
