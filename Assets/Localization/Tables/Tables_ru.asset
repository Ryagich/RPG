  - m_Id: 80000000000000008
    m_Localized: "\u0414\u043B\u0438\u043D\u043D\u0430\u044F \u0441\u0432\u0435\u0442\u043B\u0430\u044F \u043D\u0430\u043A\u0438\u0434\u043A\u0430 \u0440\u0430\u0441\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0441\u043F\u0435\u0440\u0435\u0434\u0438 \u0438 \u043F\u043E \u0431\u043E\u043A\u0430\u043C, \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F \u0432\u0438\u0434\u0438\u043C\u044B\u043C\u0438 \u0442\u0451\u043C\u043D\u044B\u0435 \u0448\u0442\u0430\u043D\u044B \u043F\u043E\u0434 \u043D\u0435\u0439. \u041E\u043D\u0430 \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F \u043D\u0430 \u0440\u0435\u043C\u043D\u0435 \u0438 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442 \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u043E\u0434\u0435\u0436\u0434\u0435 \u0434\u043B\u0438\u043D\u0443 \u0431\u0435\u0437 \u0442\u044F\u0436\u0451\u043B\u043E\u0439 \u0441\u043F\u043B\u043E\u0448\u043D\u043E\u0439 \u044E\u0431\u043A\u0438."
