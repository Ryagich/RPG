  - m_Id: 83000000000000002
    m_Localized: "\u041A\u0440\u0443\u043F\u043D\u043E\u0435 \u044F\u0431\u043B\u043E\u043A\u043E \u0441 \u043F\u043B\u043E\u0442\u043D\u043E\u0439 \u043A\u043E\u0436\u0438\u0446\u0435\u0439 \u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0439 \u043F\u043B\u043E\u0434\u043E\u043D\u043E\u0436\u043A\u043E\u0439. \u0415\u0433\u043E \u0446\u0435\u043D\u044F\u0442 \u043D\u0435 \u0437\u0430 \u0438\u0437\u044B\u0441\u043A\u0430\u043D\u043D\u043E\u0441\u0442\u044C, \u0430 \u0437\u0430 \u0442\u043E, \u0447\u0442\u043E \u043E\u043D\u043E \u0434\u0430\u0451\u0442 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0441\u043B\u0430\u0434\u043A\u043E\u0439 \u0432\u043B\u0430\u0433\u0438 \u0438 \u0431\u043E\u0434\u0440\u043E\u0441\u0442\u0438 \u0432 \u0434\u043E\u0440\u043E\u0433\u0435; \u0441\u0430\u0434\u043E\u0432\u043D\u0438\u043A\u0438 \u0433\u043E\u0432\u043E\u0440\u044F\u0442, \u0447\u0442\u043E \u0445\u043E\u0440\u043E\u0448\u0435\u0435 \u044F\u0431\u043B\u043E\u043A\u043E \u0434\u043E\u043B\u0436\u043D\u043E \u0445\u0440\u0443\u0441\u0442\u043D\u0443\u0442\u044C \u0440\u0430\u043D\u044C\u0448\u0435, \u0447\u0435\u043C \u043F\u0443\u0442\u043D\u0438\u043A \u0443\u0441\u043F\u0435\u0435\u0442 \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u043F\u0443\u0442\u044C. \u0412 \u043C\u0435\u0448\u043A\u0435 \u0435\u0433\u043E \u0434\u0435\u0440\u0436\u0430\u0442 \u0441\u0432\u0435\u0440\u0445\u0443: \u043E\u0442 \u0443\u0434\u0430\u0440\u0430 \u043E\u043D\u043E \u0442\u0435\u043C\u043D\u0435\u0435\u0442 \u0431\u044B\u0441\u0442\u0440\u0435\u0435, \u0447\u0435\u043C \u043F\u043E\u0440\u0442\u0438\u0442\u0441\u044F \u043D\u0430 \u0432\u043A\u0443\u0441."
