    m_Localized: "\u0414\u043B\u0438\u043D\u043D\u044B\u0439 \u043C\u0435\u0447 \u0441 \u043B\u0430\u0442\u0443\u043D\u043D\u043E\u0439 \u0433\u0430\u0440\u0434\u043E\u0439"
    m_Metadata: {m_Items: []}
  - m_Id: 78000000000000041
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u043E \u0441\u0431\u0430\u043B\u0430\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u043C\u0435\u0447 \u0440\u0430\u0431\u043E\u0442\u044B \u0443\u043C\u0435\u043B\u043E\u0433\u043E, \u043D\u043E \u043D\u0435 \u0438\u043C\u0435\u043D\u0438\u0442\u043E\u0433\u043E \u043A\u0443\u0437\u043D\u0435\u0446\u0430. \u041A\u043B\u0438\u043D\u043E\u043A \u043F\u043E\u0441\u043B\u0443\u0448\u0435\u043D \u0432 \u0440\u0443\u043A\u0435, \u043B\u0430\u0442\u0443\u043D\u043D\u0430\u044F \u0433\u0430\u0440\u0434\u0430 \u0441\u0434\u0435\u043B\u0430\u043D\u0430 \u0431\u0435\u0437 \u043F\u043E\u043A\u0430\u0437\u043D\u043E\u0439 \u0440\u0435\u0437\u044C\u0431\u044B, \u0430 \u043D\u0430\u0432\u0435\u0440\u0448\u0438\u0435 \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u043D\u043E \u0442\u0430\u043A, \u0447\u0442\u043E\u0431\u044B \u043C\u0435\u0447 \u043D\u0435 \u043A\u043B\u0435\u0432\u0430\u043B \u043D\u043E\u0441\u043E\u043C \u0432 \u0443\u0434\u0430\u0440\u0435. \u041A\u0430\u0436\u0434\u0430\u044F \u043C\u043E\u043D\u0435\u0442\u0430 \u0432 \u0435\u0433\u043E \u0446\u0435\u043D\u0435 \u0443\u043F\u043B\u0430\u0447\u0435\u043D\u0430 \u0437\u0430 \u0441\u0442\u0430\u043B\u044C \u0438 \u0440\u0430\u0431\u043E\u0442\u0443, \u0430 \u043D\u0435 \u0437\u0430 \u0433\u0440\u043E\u043C\u043A\u043E\u0435 \u0438\u043C\u044F \u043C\u0430\u0441\u0442\u0435\u0440\u0430. \u0422\u0430\u043A\u043E\u0435 \u043E\u0440\u0443\u0436\u0438\u0435 \u0432\u044B\u0431\u0438\u0440\u0430\u044E\u0442 \u043D\u0435\u0431\u043E\u0433\u0430\u0442\u044B\u0435 \u0434\u0432\u043E\u0440\u044F\u043D\u0435 \u0438 \u043B\u044E\u0434\u0438 \u043F\u0440\u0438 \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u0438: \u0438\u043C \u043D\u0443\u0436\u0435\u043D \u0432\u0435\u0440\u043D\u044B\u0439 \u043A\u043B\u0438\u043D\u043E\u043A \u043D\u0430 \u0433\u043E\u0434\u044B, \u0430 \u043D\u0435 \u0444\u0430\u043C\u0438\u043B\u044C\u043D\u0430\u044F \u0432\u0435\u0449\u044C \u0434\u043B\u044F \u043F\u0430\u0440\u0430\u0434\u043D\u043E\u0433\u043E \u043F\u043E\u044F\u0441\u0430. \u0415\u0441\u043B\u0438 \u0437\u0430 \u043D\u0438\u043C \u0441\u043B\u0435\u0434\u0438\u0442\u044C, \u043E\u043D \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0451\u0442 \u043D\u0435 \u043E\u0434\u043D\u0443 \u0441\u043C\u0435\u043D\u0443 \u0445\u043E\u0437\u044F\u0435\u0432."
    m_Metadata: {m_Items: []}
