  - m_Id: 18140639991676928
    m_Localized: "\u0417\u0430\u0434\u0430\u043D\u0438\u0435 \u0441\u043A\u0435\u043B\u0435\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 18378461193420800
    m_Localized: "\u0410\u041B\u0445\u0437\u0446\u0443\u043F\u043A\u0435\u0438\u0446\u043A\u0435\u0438
      \u0443\u043A\u043C \u0446\u0443\u043A\u043C \u0443\u0444\u043A\u0444 \u0444\u043A
      \u043C\u0444\u0443\u043A\u043C\u0444\u0432\u043C \u0444\u0444\u043A\u0432\u043C
      \u0444\u0432\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430
      \u0430\u043C\u0444\u043C\u0443\u0444\u043A\u043C \u0444\u0443\u043A \u0444\u0443\u043A\u043C
      \u0444\u0443\u043A\u043C \u0444\u043A\u0443 \u043C\u043B\u043F\u04450\u0443\u044C\u0445
      \u0443\u043A\u043C \u0445\u044C\u0443\u043A\u043C\u0445\u0449\u044C\u0443 \u0445\u0437\u0434\u044C\u0431\u0445\u043C
      \u0449\u0443\u044D\u0445\u0449\u0439\u044C\u0446 \u0449\u044C\u0449\u0446\u0445\u0439\u043C\u044C
      \u0445\u043A\u044C \u0445\u0449\u0443\u044C\u043A\u043C\u0434\u0432\u044B\u044C\u0438
      \u043A\u0435\u0449\u043A\u0437\u0434 \u0431\u0438\u0446\u044D\u0437 \u044A-\u043F\u0431
      \u0430\u0437\u0444\u0434\u044B\u0431\u043C\u0436\u044D\u0434\u044C \u0435\u0445\u0448\u043D\u0435\u0443\u0442
      \u0445\u0437\u044C\u0443-\u0449 \u043C\u0431\u044A-203\u043B -02 \u043E\u0445
      092\u043E\u0430 -24\u043E\u0430 3-94\u043E\u0430 \u043939 -0\u0439\u0441 0\u0439\u044C3\u043E=
      \u0439=\u04438\u043C \u0440-\u043C\u044C \u0440\u04393 \u0440\u043C\u04393\u044C\u043C\u0439\u0431\u043E\u0444
      \u044C9\u043C -\u0444\u0432\u0442\u043C-\u0444 \u0442 \u043C-\u0444\u043C\u0444\u0442\u043A\u043C\u044C\u0444\u0432\u0448\u043C\u043E\u0437\u0449\u0443\u043A\u043E\u043C\u044C\u0443
      \u043E\u044C\u043C\u0449\u0432\u044C\u043E\u0430\u043C \u0442\u043A\u04438
      \u044C\u0444\u0432\u0448\u043C\u043E\u0443\u043A\u044B\u044C\u0449\u0440\u043C\u044B\u0437\u0449\u0438\u0442\u044B\u043A\u0449\u0435\u0438\u0442
      \u0449\u0437\u043A\u0435\u0438\u044C \u044B\u0438\u0435\u044C\u044B\u0449\u0430\u0438\u044B\u0449\u0443\u044C\u0438\u0445\u0443\u0437\u043C
      \u0443\u044C \u043A0\u0435\u0448\u0438\u043E \u0431\u0444\u0449\u0443\u0445\u0448\u043C\u043E\u044C
      \u044B\u0449\u0437\u043A\u0448\u044C\u0438 \u044B\u0437\u043C\u0449\u044B\u044C\u0435
      \u0438\u044B\u0449\u0435\u0438\u0449\u044B\u0445 \u0432\u0430\u0434\u0438\u0434\u044C\u044C
      \u044B\u0449\u0448\u0443\u044C \u0432\u0430\u044C\u0438 \u044B\u043E\u044C\u0449"
    m_Metadata:
      m_Items: []
  - m_Id: 18414656560545792
    m_Localized: "\u041F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0437\u0430\u0434\u0430\u043D\u0438\u0435
