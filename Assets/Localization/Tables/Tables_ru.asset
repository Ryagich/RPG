    m_Localized: "\u041D\u0430\u0431\u0435\u0434\u0440\u0435\u043D\u043D\u0438\u043A \u0441 \u043F\u0435\u0440\u0435\u0434\u043D\u0438\u043C \u0449\u0438\u0442\u043A\u043E\u043C"
