  - m_Id: 83000000000000012
    m_Localized: "\u0411\u0435\u043B\u044B\u0435 \u0433\u043E\u043B\u043E\u0432\u043A\u0438 \u0440\u043E\u043C\u0430\u0448\u043A\u0438 \u0441 \u0436\u0451\u043B\u0442\u044B\u043C\u0438 \u0441\u0435\u0440\u0434\u0446\u0435\u0432\u0438\u043D\u0430\u043C\u0438 \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0442 \u0432 \u0441\u0443\u0445\u0443\u044E \u043F\u043E\u0433\u043E\u0434\u0443, \u043F\u043E\u043A\u0430 \u043B\u0435\u043F\u0435\u0441\u0442\u043A\u0438 \u043D\u0435 \u043F\u043E\u0431\u0443\u0440\u0435\u043B\u0438. \u041F\u043E\u043B\u0435\u0432\u044B\u0435 \u0442\u0440\u0430\u0432\u043D\u0438\u043A\u0438 \u0441\u0443\u0448\u0430\u0442 \u0446\u0432\u0435\u0442\u043A\u0438 \u0434\u043B\u044F \u043C\u044F\u0433\u043A\u043E\u0433\u043E \u043D\u0430\u0441\u0442\u043E\u044F \u0438 \u0441\u0447\u0438\u0442\u0430\u044E\u0442 \u0435\u0433\u043E \u043F\u0435\u0440\u0432\u043E\u0439 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043F\u0440\u0438 \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u0438, \u0442\u0440\u0435\u0432\u043E\u0433\u0435 \u0438 \u043C\u0435\u043B\u043A\u0438\u0445 \u0434\u043E\u0440\u043E\u0436\u043D\u044B\u0445 \u043D\u0435\u0434\u0443\u0433\u0430\u0445; \u043F\u043E\u0442\u043E\u043C\u0443 \u0440\u043E\u043C\u0430\u0448\u043A\u0430 \u043F\u043E\u043D\u0435\u043C\u043D\u043E\u0433\u0443 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0441\u0438\u043B\u044B, \u0430 \u043D\u0435 \u0437\u0430\u043C\u0435\u043D\u044F\u0435\u0442 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u043B\u0435\u0447\u0435\u043D\u0438\u0435. \u0412 \u0441\u0442\u0430\u0440\u044B\u0445 \u0437\u0430\u043F\u0438\u0441\u044F\u0445 \u0435\u0451 \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u0442\u0438\u0445\u043E\u0439 \u0442\u0440\u0430\u0432\u043E\u0439: \u043E\u043D\u0430 \u043D\u0435 \u0442\u0432\u043E\u0440\u0438\u0442 \u0447\u0443\u0434\u0435\u0441, \u043D\u043E \u0440\u0435\u0434\u043A\u043E \u0431\u044B\u0432\u0430\u0435\u0442 \u043B\u0438\u0448\u043D\u0435\u0439 \u0432 \u0441\u0443\u043C\u043A\u0435."
