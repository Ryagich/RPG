  - m_Id: 82000000000000008
    m_Localized: "\u0412\u044B\u0441\u043E\u043A\u0438\u0435 \u043F\u043E\u043D\u043E\u0436\u0438 \u0441\u043E\u0431\u0440\u0430\u043D\u044B \u0438\u0437 \u0442\u0451\u043C\u043D\u043E\u0439 \u043E\u0441\u043D\u043E\u0432\u044B, \u0441\u0432\u0435\u0442\u043B\u044B\u0445 \u043D\u0430\u043A\u043B\u0430\u0434\u043E\u043A \u043D\u0430 \u0433\u043E\u043B\u0435\u043D\u0438 \u0438 \u043F\u043B\u043E\u0442\u043D\u044B\u0445 \u0441\u0442\u0443\u043F\u043D\u0435\u0439. \u0417\u0430\u043E\u0441\u0442\u0440\u0451\u043D\u043D\u044B\u0439 \u043A\u0440\u0430\u0439 \u0449\u0438\u0442\u043A\u0430 \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043F\u0435\u0440\u0435\u0434 \u043D\u043E\u0433\u0438, \u0430 \u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u043F\u0435\u0440\u0435\u0445\u043E\u0434 \u043A \u043E\u0431\u0443\u0432\u0438 \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0439 \u0441\u043B\u043E\u0436\u043D\u043E\u0439 \u0437\u0430\u0441\u0442\u0451\u0436\u043A\u0438."
