  - m_Id: 82000000000000004
    m_Localized: "\u0414\u043B\u0438\u043D\u043D\u044B\u0435 \u0442\u0451\u043C\u043D\u044B\u0435 \u043F\u0435\u0440\u0447\u0430\u0442\u043A\u0438 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u043A\u0438\u0441\u0442\u044C \u0438 \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u0435\u0434\u043F\u043B\u0435\u0447\u044C\u044F, \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F \u043F\u0430\u043B\u044C\u0446\u0430\u043C \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u0443\u044E \u043F\u043E\u0434\u0432\u0438\u0436\u043D\u043E\u0441\u0442\u044C. \u0422\u0430\u043A\u043E\u0439 \u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u043F\u043E\u043A\u0440\u043E\u0439 \u0431\u0435\u0440\u0435\u0436\u0451\u0442 \u0440\u0443\u043A\u0438 \u043E\u0442 \u0433\u0440\u044F\u0437\u0438, \u0440\u0435\u043C\u043D\u0435\u0439 \u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0433\u043E \u0436\u0435\u043B\u0435\u0437\u0430, \u043D\u0435 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0443 \u0441 \u043C\u0435\u043B\u043E\u0447\u044C\u044E \u0432 \u043C\u0443\u0447\u0435\u043D\u0438\u0435."
