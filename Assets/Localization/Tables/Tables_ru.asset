  - m_Id: 80000000000000038
    m_Localized: "\u0421\u0432\u0435\u0442\u043B\u044B\u0439 \u043F\u0435\u0440\u0435\u0434\u043D\u0438\u043A \u0437\u0430\u043A\u0440\u0435\u043F\u043B\u0451\u043D \u043C\u0435\u0436\u0434\u0443 \u0442\u0451\u043C\u043D\u044B\u043C\u0438 \u0431\u043E\u043A\u043E\u0432\u044B\u043C\u0438 \u043F\u043E\u043B\u043E\u0442\u043D\u0438\u0449\u0430\u043C\u0438 \u0438 \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043F\u0435\u0440\u0435\u0434 \u0431\u0451\u0434\u0435\u0440. \u041A\u043E\u043D\u0442\u0440\u0430\u0441\u0442\u043D\u044B\u0435 \u0441\u043B\u043E\u0438 \u043E\u0442\u0434\u0435\u043B\u044F\u044E\u0442 \u0440\u0430\u0431\u043E\u0447\u0438\u0435 \u0447\u0430\u0441\u0442\u0438 \u043E\u0434\u0435\u0436\u0434\u044B \u0434\u0440\u0443\u0433 \u043E\u0442 \u0434\u0440\u0443\u0433\u0430: \u043F\u043E\u044F\u0441 \u043C\u043E\u0436\u043D\u043E \u0437\u0430\u0442\u044F\u043D\u0443\u0442\u044C, \u043D\u0435 \u0442\u0440\u043E\u0433\u0430\u044F \u043E\u0441\u043D\u043E\u0432\u043D\u0443\u044E \u0442\u043A\u0430\u043D\u044C."
    m_Metadata: {m_Items: []}
  - m_Id: 80000000000000039
    m_Localized: "\u0414\u043B\u0438\u043D\u043D\u044B\u0439 \u043F\u0435\u0440\u0435\u0434\u043D\u0438\u043A \u0441 \u0431\u043E\u043A\u043E\u0432\u044B\u043C\u0438 \u043D\u0430\u043A\u043B\u0430\u0434\u043A\u0430\u043C\u0438"
