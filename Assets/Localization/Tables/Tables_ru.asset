    m_Localized: "\u0422\u0451\u043C\u043D\u044B\u0435 \u0448\u0442\u0430\u043D\u044B \u0443\u0441\u0438\u043B\u0435\u043D\u044B \u0431\u043E\u043B\u044C\u0448\u0438\u043C\u0438 \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u044B\u043C\u0438 \u043D\u0430\u043A\u043B\u0430\u0434\u043A\u0430\u043C\u0438 \u043F\u043E \u0431\u043E\u043A\u0430\u043C \u0431\u0451\u0434\u0435\u0440 \u0438 \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0447\u0435\u043D\u044B \u0440\u0435\u043C\u043D\u044F\u043C\u0438. \u0422\u0430\u043A\u043E\u0439 \u043F\u043E\u043A\u0440\u043E\u0439 \u0443\u043C\u0435\u0441\u0442\u0435\u043D \u0442\u0430\u043C, \u0433\u0434\u0435 \u043E\u0434\u0435\u0436\u0434\u0430 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E \u043A\u0430\u0441\u0430\u0435\u0442\u0441\u044F \u0441\u0435\u0434\u043B\u0430, \u0441\u043A\u0430\u043C\u044C\u0438 \u0438\u043B\u0438 \u0442\u044F\u0436\u0451\u043B\u043E\u0439 \u043D\u043E\u0448\u0438."
