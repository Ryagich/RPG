  - m_Id: 79000000000000052
    m_Localized: "\u0421\u0432\u0435\u0442\u043B\u0430\u044F \u0434\u043E\u0440\u043E\u0436\u043D\u0430\u044F \u0440\u0443\u0431\u0430\u0445\u0430 \u0441 \u0442\u0451\u043C\u043D\u043E\u0439 \u0442\u043A\u0430\u043D\u044C\u044E \u043D\u0430 \u043E\u0434\u043D\u043E\u043C \u043F\u043B\u0435\u0447\u0435 \u0438 \u0448\u0438\u0440\u043E\u043A\u043E\u0439 \u043A\u043E\u0436\u0430\u043D\u043E\u0439 \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u044C\u044E \u0441\u043E\u0431\u0440\u0430\u043D\u0430 \u0438\u0437 \u043B\u0435\u0433\u043A\u043E \u0437\u0430\u043C\u0435\u043D\u044F\u0435\u043C\u044B\u0445 \u0447\u0430\u0441\u0442\u0435\u0439. \u041F\u043E\u043B\u043E\u0441\u044B \u043C\u0430\u0442\u0435\u0440\u0438\u0438 \u043F\u043E\u0434 \u0440\u0435\u043C\u043D\u044F\u043C\u0438 \u0437\u0430\u0449\u0438\u0449\u0430\u044E\u0442 \u043E\u0441\u043D\u043E\u0432\u0443 \u043E\u0442 \u0442\u0440\u0435\u043D\u0438\u044F \u0438 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044E\u0442 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0442\u0435\u043F\u043B\u0430 \u0432 \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u043D\u0443\u044E \u043F\u043E\u0433\u043E\u0434\u0443."
