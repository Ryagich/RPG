  - m_Id: 80000000000000020
    m_Localized: "\u0414\u043B\u0438\u043D\u043D\u0430\u044F \u043D\u0430\u043A\u0438\u0434\u043A\u0430 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043E\u0434\u043D\u043E \u0431\u0435\u0434\u0440\u043E \u043F\u043E\u0447\u0442\u0438 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E, \u0430 \u0434\u0440\u0443\u0433\u043E\u0435 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0432 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u043C \u043F\u043E\u043B\u043E\u0442\u043D\u0438\u0449\u0435. \u041F\u043E\u0434 \u043D\u0435\u0439 \u0432\u0438\u0434\u043D\u0430 \u0442\u0451\u043C\u043D\u0430\u044F \u0443\u0437\u043E\u0440\u043D\u0430\u044F \u0432\u0441\u0442\u0430\u0432\u043A\u0430: \u0434\u0435\u0442\u0430\u043B\u044C \u043D\u0435 \u0434\u043B\u044F \u043F\u0430\u0440\u0430\u0434\u0430, \u0430 \u0434\u043B\u044F \u0432\u0435\u0449\u0438, \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0445\u043E\u0437\u044F\u0438\u043D \u043D\u0435 \u0445\u043E\u0447\u0435\u0442 \u043F\u0443\u0442\u0430\u0442\u044C \u0441 \u0447\u0443\u0436\u043E\u0439."
