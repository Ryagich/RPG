  - m_Id: 79000000000000008
    m_Localized: "\u041F\u0440\u0438\u0442\u0430\u043B\u0435\u043D\u043D\u044B\u0439 \u043A\u043E\u0436\u0430\u043D\u044B\u0439 \u0436\u0438\u043B\u0435\u0442 \u0441 \u0434\u0432\u0443\u043C\u044F \u0440\u044F\u0434\u0430\u043C\u0438 \u0437\u0430\u0441\u0442\u0451\u0436\u0435\u043A \u0438 \u0441\u0432\u0435\u0442\u043B\u043E\u0439 \u043E\u043A\u0430\u043D\u0442\u043E\u0432\u043A\u043E\u0439 \u0441\u0448\u0438\u0442 \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u0435\u0435 \u043E\u0431\u044B\u0447\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0439 \u043E\u0434\u0435\u0436\u0434\u044B. \u041E\u043D \u0445\u043E\u0440\u043E\u0448\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0441\u044F \u043F\u043E\u0432\u0435\u0440\u0445 \u0447\u0438\u0441\u0442\u043E\u0439 \u0440\u0443\u0431\u0430\u0445\u0438, \u043D\u043E \u043F\u043E\u0442\u0451\u0440\u0442\u044B\u0435 \u043A\u0440\u0430\u044F \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u043C\u043E\u0436\u043D\u043E \u043E\u0431\u043D\u043E\u0432\u0438\u0442\u044C \u0432\u043E\u0441\u043A\u043E\u043C \u043F\u043E\u0441\u043B\u0435 \u0434\u043E\u043B\u0433\u043E\u0439 \u043D\u043E\u0441\u043A\u0438."
