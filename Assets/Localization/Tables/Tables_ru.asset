  - m_Id: 80000000000000036
    m_Localized: "\u041A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u044B\u0439 \u043F\u0435\u0440\u0435\u0434\u043D\u0438\u043A \u0441\u0432\u0438\u0441\u0430\u0435\u0442 \u043E\u0442 \u043F\u043E\u044F\u0441\u0430 \u043E\u0441\u0442\u0440\u044B\u043C \u043A\u0440\u0430\u0435\u043C \u0438 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0448\u0442\u0430\u043D\u0430\u043C \u0441\u0432\u043E\u0431\u043E\u0434\u0443 \u043F\u043E \u0431\u043E\u043A\u0430\u043C. \u041F\u043B\u043E\u0442\u043D\u044B\u0435 \u0431\u043E\u043A\u043E\u0432\u044B\u0435 \u0432\u0441\u0442\u0430\u0432\u043A\u0438 \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u0431\u0451\u0434\u0440\u0430, \u043D\u0435 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u044F \u043E\u0434\u0435\u0436\u0434\u0443 \u0432 \u0434\u043B\u0438\u043D\u043D\u0443\u044E \u0438 \u043D\u0435\u0443\u0434\u043E\u0431\u043D\u0443\u044E \u044E\u0431\u043A\u0443."
