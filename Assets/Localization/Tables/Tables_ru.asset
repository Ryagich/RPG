  - m_Id: 83000000000000004
    m_Localized: "\u0422\u0451\u043C\u043D\u043E-\u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u043A\u043E\u0440\u043D\u0435\u043F\u043B\u043E\u0434, \u0432\u044B\u0442\u0430\u0449\u0435\u043D\u043D\u044B\u0439 \u0438\u0437 \u0437\u0435\u043C\u043B\u0438 \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u0433\u0440\u0443\u0431\u043E\u0439 \u0431\u043E\u0442\u0432\u043E\u0439. \u041E\u043D \u043D\u0435 \u0443\u0442\u043E\u043B\u0438\u0442 \u0436\u0430\u0436\u0434\u0443 \u0442\u0430\u043A \u0449\u0435\u0434\u0440\u043E, \u043A\u0430\u043A \u0441\u0432\u0435\u0436\u0438\u0439 \u043F\u043B\u043E\u0434, \u0437\u0430\u0442\u043E \u0434\u043E\u043B\u0433\u043E \u043B\u0435\u0436\u0438\u0442 \u0432 \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u0435 \u0438 \u043F\u0440\u0438\u0434\u0430\u0451\u0442 \u0441\u0438\u043B \u043F\u043E\u0441\u043B\u0435 \u0441\u043A\u0443\u0434\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0438. \u041D\u0430 \u043A\u0443\u0445\u043D\u044F\u0445 \u0441\u0432\u0451\u043A\u043B\u0443 \u043B\u044E\u0431\u044F\u0442 \u0437\u0430 \u0441\u043B\u0430\u0434\u043A\u043E\u0432\u0430\u0442\u0443\u044E \u043F\u043B\u043E\u0442\u044C, \u0430 \u043F\u0440\u0430\u0447\u043A\u0438 \u043D\u0435\u0434\u043E\u043B\u044E\u0431\u043B\u0438\u0432\u0430\u044E\u0442 \u0437\u0430 \u0441\u043E\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432\u044A\u0435\u0434\u0430\u0435\u0442\u0441\u044F \u0432 \u043F\u0430\u043B\u044C\u0446\u044B \u0438 \u0442\u043A\u0430\u043D\u044C."
